---
// "Lo que más sale": filas de envases a todo el ancho, como al abrir la caja.
// Cada fila termina en una cenefa (la etiqueta de la góndola) con el nombre, la marca y el dato.
import { categorias, masVendidos, type Producto } from '../../../data';
import { waLink } from '../../../lib/whatsapp';
import { categoria, enumerar } from '../sistema';
import Almohadilla from './Almohadilla.astro';
import SobrePapel from './SobrePapel.astro';
import Pote from './Pote.astro';
import Paquete from './Paquete.astro';

const productos = masVendidos();
const envaseDe = (p: Producto) => categorias.find((c) => c.slug === p.categoria)?.envase ?? 'sobre';
const nombreConMarca = (p: Producto) => (p.marca ? `${p.nombre} ${p.marca}` : p.nombre);
const dato = (p: Producto) =>
  p.variantes ? `${enumerar(p.variantes).replace(/^./, (l) => l.toUpperCase())}` : (p.nota ?? '');

const N = 22; // envases por fila: sobran a propósito, la fila se corta en los bordes
const repeticiones = Array.from({ length: N }, (_, i) => i);
const intro = enumerar(productos.map((p) => nombreConMarca(p).replace(/^./, (l) => l.toLowerCase())));
---
<section class="b-mas" aria-labelledby="b-mas-titulo">
  <div class="b-contenedor b-mas__cabeza">
    <h2 id="b-mas-titulo" class="b-display b-mas__titulo">Lo que más sale</h2>
    <p class="b-mas__intro">
      Lo que más nos piden bares, kioscos y clínicas: {intro}. Cada porción en su envase, para la bandeja del
      almuerzo o el mostrador del bar.
    </p>
  </div>

  <ul class="b-mas__filas" role="list">
    {productos.map((p) => {
      const envase = envaseDe(p);
      return (
        <li class:list={['b-fila', `b-fila--${envase}`]}>
          <div class="b-fila__envases" aria-hidden="true">
            {repeticiones.map((i) => {
              if (envase === 'sobre') return <Almohadilla clave={p.slug} etiqueta={p.nombre} />;
              if (envase === 'sobre-papel')
                return <SobrePapel variante={p.slug === 'edulcorante' ? 'edulcorante' : 'azucar'} etiqueta={p.nombre} />;
              if (envase === 'pote') {
                const sabor = p.variantes?.[i % p.variantes.length] ?? p.slug;
                return <Pote clave={sabor} etiqueta={sabor} />;
              }
              return <Paquete tipo="galletitas" etiqueta={p.nombre} />;
            })}
          </div>
          <div class="b-fila__cenefa">
            <div class="b-contenedor b-fila__cenefa-in">
              <h3 class="b-fila__nombre">{p.variantes ? categoria(p.categoria).nombre : p.nombre}</h3>
              {p.marca && <p class="b-fila__marca">{p.marca}</p>}
              <p class="b-fila__dato">{dato(p)}</p>
              <a class="b-fila__precio" href={waLink('producto', { producto: nombreConMarca(p).toLowerCase() })} target="_blank" rel="noopener">
                Preguntá el precio<span aria-hidden="true">&nbsp;→</span>
              </a>
            </div>
          </div>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .b-mas { padding-top: clamp(3rem, 7vw, 6.5rem); }
  .b-mas__cabeza {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .b-mas__titulo { font-size: clamp(2.3rem, 1rem + 4.4vw, 5.25rem); }
  .b-mas__intro { max-width: 34em; }

  .b-mas__filas {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  .b-fila { min-width: 0; }

  .b-fila__envases {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    overflow: clip;
    padding-block: 4px;
  }
  .b-fila__envases > :global(svg) { flex: none; height: auto; }

  /* Almohadillas paradas, apretadas como en la caja */
  .b-fila--sobre .b-fila__envases { gap: clamp(5px, 0.6vw, 9px); }
  .b-fila--sobre .b-fila__envases > :global(svg) { width: clamp(46px, 5.6vw, 84px); }
  .b-fila--sobre .b-fila__envases > :global(svg:nth-child(3n + 2)) { margin-bottom: 7px; }
  .b-fila--sobre .b-fila__envases > :global(svg:nth-child(4n)) { margin-bottom: 3px; }

  /* Sobres de papel encimados */
  .b-fila--sobre-papel .b-fila__envases > :global(svg) { width: clamp(118px, 12vw, 184px); }
  .b-fila--sobre-papel .b-fila__envases > :global(svg + svg) { margin-left: calc(clamp(118px, 12vw, 184px) * -0.2); }

  /* Potecitos en hilera */
  .b-fila--pote .b-fila__envases { gap: clamp(8px, 1vw, 14px); }
  .b-fila--pote .b-fila__envases > :global(svg) { width: clamp(78px, 8vw, 124px); }

  .b-fila--paquete .b-fila__envases { gap: 10px; }
  .b-fila--paquete .b-fila__envases > :global(svg) { width: clamp(120px, 12vw, 180px); }

  /* Cenefa: la etiqueta del estante */
  .b-fila__cenefa {
    margin-top: 0.9rem;
    background: var(--b-tinta);
    color: var(--b-papel);
  }
  .b-fila__cenefa-in {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.15rem 1rem;
    padding-block: 0.8rem;
  }
  .b-fila__nombre {
    font-stretch: 125%;
    font-weight: 900;
    font-size: 1.375rem;
    line-height: 1.05;
  }
  .b-fila__marca {
    grid-column: 2;
    grid-row: 1;
    font-stretch: 125%;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .b-fila__dato { grid-column: 1 / -1; font-size: 0.9375rem; opacity: 0.9; }
  .b-fila__precio {
    grid-column: 1 / -1;
    justify-self: start;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--b-papel);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }
  .b-fila__precio:focus-visible { outline-color: var(--b-papel); box-shadow: none; }

  @media (min-width: 900px) {
    .b-fila__cenefa-in {
      grid-template-columns: auto auto 1fr auto;
      gap: 1.75rem;
      padding-block: 1rem;
    }
    .b-fila__nombre { font-size: 1.75rem; }
    .b-fila__marca { grid-column: auto; grid-row: auto; }
    .b-fila__dato { grid-column: auto; }
    .b-fila__precio { grid-column: auto; }
  }
</style>
