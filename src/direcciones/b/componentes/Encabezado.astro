---
import { empresa } from '../../../data';
import { waLink } from '../../../lib/whatsapp';
import Wordmark from './Wordmark.astro';
import Estado from './Estado.astro';
import Boton from './Boton.astro';

const secciones = [
  { href: '#productos', texto: 'Productos' },
  { href: '#clinicas', texto: 'Clínicas' },
  { href: '#comercios', texto: 'Comercios' },
  { href: '#entregas', texto: 'Entregas' },
  { href: '#lista', texto: 'Lista de precios' },
];
---
<header class="b-encabezado">
  <div class="b-contenedor b-encabezado__fila">
    <a href="#inicio" class="b-encabezado__marca" aria-label={`${empresa.nombreComercial}, ir al inicio`}>
      <Wordmark class="b-encabezado__wordmark" />
    </a>
    <nav class="b-encabezado__nav" aria-label="Secciones">
      <ul>
        {secciones.map((s) => <li><a href={s.href}>{s.texto}</a></li>)}
      </ul>
    </nav>
    <div class="b-encabezado__accion">
      <Estado modo="corto" />
      <Boton href={waLink('general')} externo class="b-encabezado__boton">Escribile a {empresa.whatsapp.atiende}</Boton>
    </div>
  </div>
</header>

<style>
  .b-encabezado {
    background: var(--b-papel);
    border-bottom: 2px solid var(--b-tinta);
  }
  .b-encabezado__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.75rem;
    padding-block: 0.85rem;
  }
  .b-encabezado__marca { display: block; flex: none; border-radius: 2px; }
  .b-encabezado__marca :global(.b-encabezado__wordmark) { width: 8.75rem; }
  .b-encabezado__nav { display: none; }
  .b-encabezado__accion { display: flex; align-items: center; gap: 1rem; }
  .b-encabezado__accion :global(.b-boton) { display: none; }

  @media (min-width: 1080px) {
    .b-encabezado__fila { min-height: 6rem; }
    .b-encabezado__marca :global(.b-encabezado__wordmark) { width: 10.5rem; }
    .b-encabezado__nav { display: block; margin-right: auto; margin-left: 2.5rem; }
    .b-encabezado__nav ul { display: flex; gap: 1.6rem; padding: 0; list-style: none; }
    .b-encabezado__nav a {
      font-stretch: 112%;
      font-weight: 700;
      font-size: 0.9375rem;
      text-decoration: none;
      padding-block: 0.4rem;
      border-bottom: 3px solid transparent;
    }
    .b-encabezado__nav a:hover { border-bottom-color: currentColor; }
    .b-encabezado__accion :global(.b-boton) { display: inline-flex; }
    .b-encabezado__accion :global(.b-boton__cuerpo) { min-height: 3rem; padding: 0.6rem 1.2rem; font-size: 0.9375rem; }
  }
</style>
