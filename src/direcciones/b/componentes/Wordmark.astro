---
// Propuesta de wordmark "DPI" (dirección B). Misma estructura que el logo actual:
// esfera + DPI + línea + "Productos Individuales". La esfera pasa a ser un punto sólido
// que toma el color de la sección (--b-punto); la línea, una barra gruesa que sale del punto.
import { empresa } from '../../../data';
import { bajada, barra, caja, dpi, punto } from '../wordmark';

interface Props {
  class?: string;
  /** Color del punto (una custom property o un color). */
  colorPunto?: string;
  /** Color de las letras y la barra. */
  colorTinta?: string;
  /** false = sin "Productos Individuales" (para usos chicos). */
  bajada?: boolean;
}
const { class: clase, colorPunto = 'var(--b-verde)', colorTinta = 'var(--b-tinta)', bajada: conBajada = true } = Astro.props;
const alto = conBajada ? caja.alto : 688 + barra.y + barra.alto;
const nombre = `${empresa.nombreComercial} · ${empresa.razonSocial.replace(/ SRL$/, '')}`;
---
<svg
  class:list={['b-wordmark', clase]}
  viewBox={`${caja.x} ${caja.y} ${caja.ancho} ${alto}`}
  role="img"
  aria-label={nombre}
  style={`--wm-punto: ${colorPunto}; --wm-tinta: ${colorTinta};`}
>
  <rect x={barra.x} y={barra.y} width={barra.ancho} height={barra.alto} fill="var(--wm-tinta)" />
  <circle cx={punto.cx} cy={punto.cy} r={punto.r} fill="var(--wm-punto)" />
  <path d={dpi} fill="var(--wm-tinta)" />
  {conBajada && <path d={bajada} fill="var(--wm-tinta)" />}
</svg>

<style>
  .b-wordmark { display: block; height: auto; overflow: visible; }
</style>
