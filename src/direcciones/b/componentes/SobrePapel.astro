---
// Sobre cuadrado de papel con borde dentado: azúcar o edulcorante DPI.
// El de edulcorante es el sobre propio de DPI (blanco con la curva verde): lleva la marca DPI y el teléfono.
import { empresa, productoPorSlug } from '../../../data';
import { telefonoCorto } from '../sistema';

interface Props {
  variante: 'azucar' | 'edulcorante';
  /** Texto principal impreso (por defecto, el nombre del producto). */
  etiqueta?: string;
  /** Muestra teléfono y mail impresos (para usos grandes). */
  detalle?: boolean;
  class?: string;
  style?: string;
  /** Si el sobre es informativo (no decorativo), su descripción. */
  titulo?: string;
}
const { variante, etiqueta, detalle = false, class: clase, style = '', titulo } = Astro.props;
// Las variantes coinciden con el slug del producto: el nombre impreso sale de src/data/.
const texto = (etiqueta ?? productoPorSlug(variante)?.nombre ?? variante).toUpperCase();
const tel = `Tel. ${telefonoCorto()}`;
---
<svg
  class:list={['b-envase b-sob', `b-sob--${variante}`, clase]}
  viewBox="0 0 130 100"
  focusable="false"
  style={`--c:var(--b-blanco);${style}`}
  {...(titulo ? { role: 'img', 'aria-label': titulo } : { 'aria-hidden': 'true' })}
>
  <use href="#b-sob" />
  {variante === 'edulcorante' ? (
    <>
      <use href="#b-sob-curva" />
      <use href={detalle ? '#b-dpi-bajada' : '#b-dpi'} x="50" y={detalle ? 15 : 17} width="64" height={detalle ? 25.3 : 19} />
      <text x="70" y={detalle ? 56 : 58} text-anchor="middle" font-size={detalle ? 7.9 : 8.4} style="fill:var(--b-tinta);font-stretch:125%;font-weight:600;letter-spacing:.2em">{texto}</text>
      {detalle ? (
        <>
          <text x="70" y="70" text-anchor="middle" font-size="5.6" style="fill:var(--b-tinta);font-weight:500">{tel}</text>
          <text x="70" y="78" text-anchor="middle" font-size="5" style="fill:var(--b-tinta);font-weight:500">{empresa.email}</text>
        </>
      ) : (
        <text x="70" y="72" text-anchor="middle" font-size="5.8" style="fill:var(--b-tinta);font-weight:500">{tel}</text>
      )}
    </>
  ) : (
    <>
      <rect x="22" y="20" width="86" height="60" rx="9" style="fill:none;stroke:var(--b-tinta);stroke-width:1.6;vector-effect:non-scaling-stroke" />
      <text x="65" y="55" text-anchor="middle" font-size="13" style="fill:var(--b-tinta);font-stretch:125%;font-weight:800;letter-spacing:.12em">{texto}</text>
    </>
  )}
</svg>
