---
// Paquetito flow-pack (galletitas, vainillas, tostadas): puntas selladas a los costados
// y una ventana que deja ver lo que hay adentro.
import { contornoDentado, estrias } from '../sistema';

interface Props {
  tipo: 'galletitas' | 'vainillas' | 'tostadas';
  etiqueta: string;
  class?: string;
  style?: string;
}
const { tipo, etiqueta, class: clase, style = '' } = Astro.props;
const texto = etiqueta.toUpperCase();

const medidas = { galletitas: { w: 170, h: 100 }, vainillas: { w: 230, h: 66 }, tostadas: { w: 150, h: 120 } }[tipo];
const { w, h } = medidas;
const s = 15; // ancho del sellado
const contorno = contornoDentado(w, h, 6, 5, { izquierda: true, derecha: true });
const rayas = estrias(5, s, 6, h - 6, 3, false) + estrias(w - s, w - 5, 6, h - 6, 3, false);
const trazo = 'stroke:var(--b-tinta);stroke-width:var(--b-trazo,2);vector-effect:non-scaling-stroke;stroke-linejoin:round';
const estria = 'fill:none;stroke:var(--b-tinta);stroke-opacity:.3;stroke-width:1;vector-effect:non-scaling-stroke';

// Agujeritos de una galletita redonda
const agujeros = (cx: number, cy: number) =>
  [[-6, -5], [6, -5], [0, 1], [-6, 7], [6, 7]].map(([dx, dy]) => ({ cx: cx + dx, cy: cy + dy }));
---
<svg class:list={['b-envase b-paq', `b-paq--${tipo}`, clase]} viewBox={`0 0 ${w} ${h}`} aria-hidden="true" focusable="false" style={style}>
  <path d={contorno} style={`fill:var(--b-galletita);${trazo}`} />
  <path d={rayas} style={estria} />
  <path d={`M${s} 0V${h}M${w - s} 0V${h}`} style={`fill:none;${trazo}`} />

  {tipo === 'galletitas' && (
    <>
      <text x={w / 2} y="22" text-anchor="middle" font-size="13" style="fill:var(--b-tinta);font-stretch:125%;font-weight:900;letter-spacing:.06em">{texto}</text>
      <rect x="28" y="33" width={w - 56} height="54" rx="9" style={`fill:var(--b-papel);${trazo}`} />
      {[52, 85, 118].map((cx) => (
        <>
          <circle cx={cx} cy="60" r="15" style={`fill:var(--b-galletita);${trazo}`} />
          {agujeros(cx, 58).map((p) => <circle cx={p.cx} cy={p.cy} r="1.7" style="fill:var(--b-tinta);opacity:.55" />)}
        </>
      ))}
    </>
  )}

  {tipo === 'vainillas' && (
    <>
      <text x="44" y={h / 2} text-anchor="middle" dominant-baseline="central" font-size="10.5" style="fill:var(--b-tinta);font-stretch:80%;font-weight:900;letter-spacing:.04em">{texto}</text>
      <rect x="74" y="11" width={w - 74 - 25} height={h - 22} rx="8" style={`fill:var(--b-papel);${trazo}`} />
      {[0, 1, 2].map((i) => (
        <rect x={84 + i * 40} y={h / 2 - 7.5} width="34" height="15" rx="7.5" style={`fill:var(--b-galletita);${trazo}`} />
      ))}
    </>
  )}

  {tipo === 'tostadas' && (
    <>
      <text x={w / 2} y="23" text-anchor="middle" font-size="12.5" style="fill:var(--b-tinta);font-stretch:125%;font-weight:900;letter-spacing:.06em">{texto}</text>
      <rect x="26" y="34" width={w - 52} height="74" rx="9" style={`fill:var(--b-papel);${trazo}`} />
      {[{ x: 38, y: 44 }, { x: 62, y: 52 }].map(({ x, y }) => (
        <g transform={`translate(${x} ${y})`}>
          <path d="M5 50V22C-3 18 0 0 25 1C50 0 53 18 45 22V50Z" style={`fill:var(--b-galletita);${trazo}`} />
          <path d="M11 44V24C5 20 9 7 25 7C41 7 45 20 39 24V44Z" style="fill:var(--b-manteca)" />
        </g>
      ))}
    </>
  )}
</svg>
