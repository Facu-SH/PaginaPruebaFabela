---
// Portada: bloque verde DPI (el color del sobre propio). Primera oración, WhatsApp y estado en vivo.
import { empresa, horario } from '../../../data';
import { horaCorta } from '../../../lib/horario';
import { waLink } from '../../../lib/whatsapp';
import { categoria, enumerar, producto, zonasConReparto } from '../sistema';
import Boton from './Boton.astro';
import Estado from './Estado.astro';
import SobrePapel from './SobrePapel.astro';

const { localidad, partido } = empresa.direccion;
const que = enumerar([
  producto('mayonesa'),
  producto('azucar'),
  producto('edulcorante'),
  categoria('mermeladas').nombre.toLowerCase(),
  producto('manteca'),
  producto('galletitas'),
]);
const donde = enumerar(zonasConReparto().map((z) => z.zona));
const atiende = empresa.whatsapp.atiende;
const abre = horaCorta(horario.abre);
---
<section class="b-portada" id="inicio" aria-labelledby="b-titulo">
  <div class="b-contenedor b-portada__grilla">
    <div class="b-portada__cabeza">
      <p class="b-rotulo b-portada__rotulo">{localidad} · {partido} · desde {empresa.desde}</p>
      <h1 id="b-titulo" class="b-display b-portada__titulo">Porciones individuales para clínicas, bares y kioscos.</h1>
    </div>
    <div class="b-portada__texto">
      <p class="b-portada__oracion">
        {empresa.nombreComercial} es una distribuidora de {localidad}, {partido}, que desde {empresa.desde} vende {que} en
        porciones individuales a clínicas, bares, kioscos y comercios de {donde}.
      </p>
      <div class="b-portada__contacto">
        <p class="b-portada__dato">
          {atiende} contesta el WhatsApp desde las {abre} de la mañana. En minutos.
        </p>
        <Boton href={waLink('general')} grande externo>Escribile a {atiende} por WhatsApp</Boton>
        <Estado class="b-portada__estado" />
      </div>
    </div>

    <figure class="b-portada__sobre">
      <SobrePapel
        variante="edulcorante"
        detalle
        titulo={`Sobre de edulcorante de ${empresa.nombreComercial}: blanco con una curva verde, el logo y el teléfono impresos`}
      />
      <figcaption class="b-rotulo">El sobre de edulcorante {empresa.nombreComercial}, nuestra línea propia</figcaption>
    </figure>
  </div>
</section>
<div class="b-filo" aria-hidden="true" style="--b-filo-color: var(--b-verde)"></div>

<style>
  .b-portada {
    background: var(--b-verde);
    padding-top: clamp(2rem, 5vw, 4.5rem);
    padding-bottom: clamp(1.5rem, 4vw, 4rem);
    overflow: clip;
  }
  .b-portada__grilla {
    display: grid;
    gap: 0 1.5rem;
  }
  .b-portada__rotulo { margin-bottom: 1.1rem; }
  .b-portada__titulo {
    font-size: clamp(2.55rem, 0.9rem + 5.7vw, 5.75rem);
    max-width: 10.5em;
    text-wrap: pretty;
  }
  .b-portada__oracion {
    margin-top: 1.4rem;
    max-width: 36em;
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .b-portada__contacto {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .b-portada__dato {
    font-stretch: 118%;
    font-weight: 800;
    font-size: clamp(1.3rem, 1rem + 1.2vw, 1.9rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    max-width: 19em;
  }
  .b-portada__sobre {
    margin: 2.5rem calc(var(--b-gutter) * -1) 0 12%;
    display: grid;
    gap: 0.75rem;
    justify-items: end;
  }
  .b-portada__sobre :global(svg) {
    width: 100%;
    height: auto;
  }
  .b-portada__sobre figcaption {
    padding-right: var(--b-gutter);
    max-width: 22em;
    text-align: right;
  }

  @media (min-width: 1080px) {
    .b-portada__grilla {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }
    .b-portada__cabeza { grid-column: 1 / -1; }
    .b-portada__titulo { max-width: none; }
    .b-portada__texto { grid-column: 1 / span 6; padding-bottom: 0.5rem; }
    .b-portada__oracion { margin-top: 2.25rem; font-size: 1.1875rem; }
    .b-portada__sobre {
      grid-column: 7 / span 6;
      margin: 2.25rem 0 0;
      justify-self: end;
      width: min(100%, 36rem);
    }
    .b-portada__sobre figcaption { padding-right: 0; }
  }
</style>
