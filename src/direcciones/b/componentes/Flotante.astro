---
// Botón flotante de WhatsApp (solo celular). Un sobre oscuro con el punto de estado.
import { empresa } from '../../../data';
import { waLink } from '../../../lib/whatsapp';
---
<a class="b-flotante" href={waLink('general')} target="_blank" rel="noopener" data-b-estado="punto">
  <span class="b-flotante__cuerpo">
    <span class="b-flotante__punto" aria-hidden="true"></span>
    Escribile a {empresa.whatsapp.atiende}
    <span class="visually-hidden">por WhatsApp</span>
  </span>
</a>

<style>
  .b-flotante {
    position: fixed;
    right: 12px;
    bottom: max(12px, env(safe-area-inset-bottom));
    z-index: 20;
    display: inline-flex;
    text-decoration: none;
    color: var(--b-papel);
    filter: drop-shadow(2px 0 0 var(--b-papel)) drop-shadow(-2px 0 0 var(--b-papel)) drop-shadow(0 2px 0 var(--b-papel))
      drop-shadow(0 -2px 0 var(--b-papel));
  }
  .b-flotante__cuerpo {
    --d: 10px;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: 3.4rem;
    padding: 0.75rem 1.35rem;
    background: var(--b-tinta);
    font-stretch: 112%;
    font-weight: 800;
    font-size: 1rem;
    -webkit-mask:
      conic-gradient(from 225deg at right, #000 90deg, #0000 0) right / 51% var(--d) repeat-y,
      conic-gradient(from 45deg at left, #000 90deg, #0000 0) left / 51% var(--d) repeat-y;
    mask:
      conic-gradient(from 225deg at right, #000 90deg, #0000 0) right / 51% var(--d) repeat-y,
      conic-gradient(from 45deg at left, #000 90deg, #0000 0) left / 51% var(--d) repeat-y;
  }
  .b-flotante__punto {
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    border: 2px solid var(--b-papel);
  }
  .b-flotante[data-abierto='true'] .b-flotante__punto { background: var(--b-verde); border-color: var(--b-verde); }

  @media (min-width: 1080px) {
    .b-flotante { display: none; }
  }
</style>
