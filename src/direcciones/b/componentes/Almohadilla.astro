---
// Sobre "almohadilla" de aderezo, parado: puntas crimpadas y el nombre impreso a lo largo.
// Decorativo (aria-hidden): el nombre y la marca van siempre en texto al lado.
import { colorEnvase } from '../sistema';

interface Props {
  /** Clave de color (slug del producto). */
  clave: string;
  /** Texto impreso en el sobre. */
  etiqueta: string;
  class?: string;
  style?: string;
}
const { clave, etiqueta, class: clase, style = '' } = Astro.props;
const { c, t } = colorEnvase(clave);
const texto = etiqueta.toUpperCase();
// Que el nombre entre a lo largo del cuerpo (≈ 104 unidades útiles).
const tam = Math.min(16, 100 / (texto.length * 0.72));
---
<svg class:list={['b-envase b-alm', clase]} viewBox="0 0 64 160" aria-hidden="true" focusable="false" style={`--c:${c};${style}`}>
  <use href="#b-alm" />
  <text
    x="80"
    y="-32"
    transform="rotate(90)"
    text-anchor="middle"
    dominant-baseline="central"
    font-size={tam.toFixed(1)}
    style={`fill:${t};font-stretch:112%;font-weight:900;letter-spacing:.03em`}
  >{texto}</text>
</svg>
