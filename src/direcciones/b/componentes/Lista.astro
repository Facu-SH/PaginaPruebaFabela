---
// Lista de precios: no es pública. Se pide por WhatsApp o por mail.
import { empresa } from '../../../data';
import { textoHorario } from '../../../lib/horario';
import { mailtoLink, waLink } from '../../../lib/whatsapp';
import Boton from './Boton.astro';
import Estado from './Estado.astro';

const atiende = empresa.whatsapp.atiende;
---
<div class="b-filo b-filo--arriba" aria-hidden="true" style="--b-filo-color: var(--b-verde)"></div>
<section class="b-lista" id="lista" aria-labelledby="b-lista-titulo">
  <div class="b-contenedor b-lista__grilla">
    <div>
      <h2 id="b-lista-titulo" class="b-display b-lista__titulo">La lista de precios te la manda {atiende}</h2>
    </div>
    <div class="b-lista__accion">
      <p>
        No está en la web porque cambia seguido: te mandamos la vigente. Pedila por WhatsApp ({textoHorario().toLowerCase()})
        o por mail, a cualquier hora.
      </p>
      <Boton href={waLink('lista')} grande externo>Pedí la lista por WhatsApp</Boton>
      <a class="b-link b-lista__mail" href={mailtoLink('lista')}>
        O por mail a <span class="b-lista__correo">{empresa.email}</span>
      </a>
      <Estado />
    </div>
  </div>
</section>

<style>
  .b-lista {
    background: var(--b-verde);
    padding-block: clamp(3rem, 7vw, 6.5rem);
  }
  .b-lista__grilla { display: grid; gap: 2rem; }
  .b-lista__titulo { font-size: clamp(2.4rem, 1rem + 4.8vw, 5.75rem); max-width: 9em; }
  .b-lista__accion {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 30em;
  }
  .b-lista__correo { overflow-wrap: anywhere; }

  @media (min-width: 1080px) {
    .b-lista__grilla { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 3rem; align-items: end; }
  }
</style>
