---
// Pie: el dorso del sobre. Marco de esquinas redondeadas y letra chica, como el dorso
// de los sobres que DPI ya imprime, con el teléfono grande.
import { categorias, empresa } from '../../../data';
import { textoHorario } from '../../../lib/horario';
import { mailtoLink, telLink } from '../../../lib/whatsapp';
import { telefonoCorto } from '../sistema';
import Wordmark from './Wordmark.astro';

const { calle, localidad, partido, provincia } = empresa.direccion;
const anio = new Date().getFullYear();
---
<footer class="b-dorso">
  <div class="b-contenedor">
    <div class="b-dorso__marco">
      <div class="b-dorso__cabeza">
        <Wordmark class="b-dorso__wordmark" />
        <p class="b-dorso__leyenda">
          Distribuidora de alimentos envasados en porciones individuales. Atención a clínicas, geriátricos,
          instituciones, bares, confiterías, kioscos y almacenes. {categorias.map((c) => c.nombre).join(' · ')}.
        </p>
      </div>

      <p class="b-display b-dorso__tel">
        <a href={telLink()}>Tel.: {telefonoCorto()}</a>
      </p>

      <dl class="b-dorso__datos">
        <div>
          <dt>Nombre</dt>
          <dd>{empresa.nombreComercial} · {empresa.razonSocial}</dd>
        </div>
        <div>
          <dt>Depósito</dt>
          <dd>{calle}, {localidad}, {partido}, {provincia}</dd>
        </div>
        <div>
          <dt>Teléfono</dt>
          <dd><a href={telLink()}>{empresa.telefono}</a></dd>
        </div>
        <div>
          <dt>Mail</dt>
          <dd><a href={mailtoLink('general')}>{empresa.email}</a></dd>
        </div>
        <div>
          <dt>Horario</dt>
          <dd>{textoHorario()}</dd>
        </div>
        <div>
          <dt>En el rubro</dt>
          <dd>
            Desde {empresa.desde}
            {empresa.clientesPublicables && <> · más de {empresa.clientesPublicables} clientes</>}
          </dd>
        </div>
      </dl>
    </div>
    <p class="b-dorso__legal">© {anio} {empresa.razonSocial}.</p>
  </div>
</footer>

<style>
  .b-dorso { padding-block: clamp(3rem, 6vw, 5rem) 7rem; }
  .b-dorso__marco {
    display: grid;
    gap: 2rem;
    padding: clamp(1.25rem, 3.5vw, 3rem);
    border: 3px solid var(--b-tinta);
    border-radius: clamp(18px, 2.5vw, 32px);
  }
  .b-dorso__cabeza { display: grid; gap: 1.5rem; }
  .b-dorso__cabeza :global(.b-dorso__wordmark) { width: min(100%, 22rem); }
  .b-dorso__leyenda {
    font-stretch: 75%;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
    max-width: 40em;
  }
  .b-dorso__tel { font-size: clamp(2rem, 1rem + 4vw, 4.5rem); }
  .b-dorso__tel a { text-decoration: none; }
  .b-dorso__tel a:hover { text-decoration: underline; text-decoration-thickness: 4px; }
  .b-dorso__datos {
    display: grid;
    gap: 1rem 2rem;
    border-top: 2px solid var(--b-tinta);
    padding-top: 1.25rem;
  }
  .b-dorso__datos dt {
    font-stretch: 125%;
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .b-dorso__datos dd { font-weight: 500; }
  .b-dorso__datos a { text-decoration-thickness: 1px; text-underline-offset: 0.2em; overflow-wrap: anywhere; }
  .b-dorso__legal { margin-top: 1rem; font-size: 0.8125rem; }

  @media (min-width: 720px) {
    .b-dorso__datos { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 1080px) {
    .b-dorso { padding-bottom: 4rem; }
    .b-dorso__cabeza { grid-template-columns: auto 1fr; align-items: end; gap: 3rem; }
  }
</style>
