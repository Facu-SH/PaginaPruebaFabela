---
// Encabezado: wordmark, estado de atención y, en escritorio, índice y botón de WhatsApp.
import { empresa } from '../../../data';
import { waLink } from '../../../lib/whatsapp';
import Wordmark from './Wordmark.astro';
import Estado from './Estado.astro';
import IconoCharla from './IconoCharla.astro';

const indice = [
  { href: '#productos', texto: 'Productos' },
  { href: '#clinicas', texto: 'Clínicas' },
  { href: '#comercios', texto: 'Comercios' },
  { href: '#entregas', texto: 'Entregas' },
  { href: '#lista', texto: 'Lista de precios' },
];
---
<header class="cabecera a-caja">
  <div class="cabecera__fila">
    <a class="cabecera__marca" href="#contenido" aria-label={`${empresa.nombreComercial}, ir al inicio`}>
      <Wordmark decorativo />
    </a>
    <nav class="cabecera__indice" aria-label="Secciones">
      <ul>
        {indice.map((i) => <li><a href={i.href}>{i.texto}</a></li>)}
      </ul>
    </nav>
    <div class="cabecera__contacto">
      <Estado variante="corto" />
      <a class="a-boton cabecera__boton" href={waLink('general')}>
        <IconoCharla />
        Escribile a {empresa.whatsapp.atiende}
      </a>
    </div>
  </div>
  <hr class="a-filete-doble" />
</header>

<style>
  .cabecera {
    padding-top: 0.85rem;
  }
  .cabecera__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.7rem;
  }
  .cabecera__marca {
    display: block;
    width: 8.6rem;
    flex: none;
    color: var(--tinta);
  }
  .cabecera__indice {
    display: none;
  }
  .cabecera__contacto {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .cabecera__contacto .cabecera__boton {
    display: none;
  }

  @media (min-width: 64rem) {
    .cabecera {
      padding-top: 1.25rem;
    }
    .cabecera__marca {
      width: 11rem;
    }
    .cabecera__indice {
      display: block;
    }
    .cabecera__indice ul {
      display: flex;
      gap: 1.6rem;
      padding: 0;
      list-style: none;
    }
    .cabecera__indice a {
      font-family: var(--versalitas);
      font-weight: 500;
      font-size: 1.125rem;
      letter-spacing: 0.04em;
      text-decoration: none;
      color: var(--tinta);
      padding-block: 0.3rem;
      border-bottom: 1.5px solid transparent;
    }
    .cabecera__indice a:hover {
      border-bottom-color: currentColor;
    }
    .cabecera__contacto .cabecera__boton {
      display: inline-flex;
      min-height: 2.9rem;
      padding: 0.6em 1.1em;
      font-size: 1rem;
    }
  }
</style>
