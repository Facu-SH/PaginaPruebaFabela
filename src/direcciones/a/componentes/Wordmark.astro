---
// Propuesta de wordmark "DPI" para la dirección A (ver docs/direcciones/a.md).
// Respeta la estructura del logo actual: esfera + DPI + línea + "Productos Individuales".
// - "linea": horizontal, para el encabezado.
// - "sello": dentro del marco de esquinas redondeadas del sobre impreso, con el teléfono.
import { empresa } from '../../../data';
import { telefonoCorto } from '../lib/textos';

interface Props {
  variante?: 'linea' | 'sello';
  /** Trama fina para tamaños grandes. */
  fina?: boolean;
  class?: string;
  /** Texto alternativo. Si es decorativo, pasá decorativo. */
  decorativo?: boolean;
}
const { variante = 'linea', fina = false, class: clase, decorativo = false } = Astro.props;
const simbolo = fina ? '#a-dpi-fino' : '#a-dpi';
const alt = `${empresa.nombreComercial} · ${empresa.razonSocial.replace(/\s+S\.?R\.?L\.?$/i, '')}`;
---
{variante === 'linea' ? (
  <svg
    class:list={['a-wordmark', clase]}
    viewBox="0 0 284 118"
    role={decorativo ? undefined : 'img'}
    aria-label={decorativo ? undefined : alt}
    aria-hidden={decorativo ? 'true' : undefined}
  >
    <use href={simbolo} width="284" height="118" />
  </svg>
) : (
  <svg
    class:list={['a-wordmark', 'a-wordmark--sello', clase]}
    viewBox="0 0 340 196"
    role={decorativo ? undefined : 'img'}
    aria-label={decorativo ? undefined : `${alt} · ${telefonoCorto()}`}
    aria-hidden={decorativo ? 'true' : undefined}
  >
    <rect x="5" y="5" width="330" height="186" rx="22" fill="none" stroke="currentColor" stroke-width="4" />
    <use href={simbolo} x="28" y="22" width="284" height="118" />
    <text
      x="170"
      y="174"
      text-anchor="middle"
      fill="currentColor"
      font-family="'Alegreya Sans', system-ui, sans-serif"
      font-weight="500"
      font-size="25"
      letter-spacing="1.5"
    >{telefonoCorto()}</text>
  </svg>
)}

<style>
  .a-wordmark {
    display: block;
    height: auto;
    color: inherit;
  }
</style>
