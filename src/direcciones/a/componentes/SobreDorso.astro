---
// Dorso del sobre impreso de DPI: marco redondeado, logo, qué hace la empresa y el teléfono.
// Reinterpreta el dorso real del sobre de azúcar con los datos actuales. Decorativo.
import { categorias, empresa } from '../../../data';
import { rectanguloDentado } from '../lib/dentado';
import { telefonoCorto } from '../lib/textos';

interface Props {
  class?: string;
}
const { class: clase } = Astro.props;

const TINTA = '#1C2230';
const borde = rectanguloDentado(3, 3, 114, 90, 5, 2.4);
const rango = (a: number, b: number, p: number) => Array.from({ length: Math.floor((b - a) / p) + 1 }, (_, i) => +(a + i * p).toFixed(2));
const sans = "'Alegreya Sans', system-ui, sans-serif";
const nombres = categorias.map((c) => c.nombre);
const mitad = Math.ceil(nombres.length / 2);
const dominio = empresa.dominio.replace(/^https?:\/\//, 'www.');
---
<svg class:list={['a-dorso', clase]} viewBox="0 0 120 96" aria-hidden="true" focusable="false">
  <path d={borde} fill="#FBF8F1" />
  <path d={borde} fill="none" stroke={TINTA} stroke-width="1.4" vector-effect="non-scaling-stroke" />
  <path
    d={[...rango(7, 113, 2.6).map((x) => `M${x} 5V9.5M${x} 86.5V91`), ...rango(7, 89, 2.6).map((y) => `M5 ${y}H9.5M110.5 ${y}H115`)].join('')}
    stroke={TINTA}
    stroke-width="0.8"
    vector-effect="non-scaling-stroke"
    opacity="0.2"
  />
  <rect x="13" y="13" width="94" height="70" rx="7" fill="none" stroke={TINTA} stroke-width="1.3" vector-effect="non-scaling-stroke" />
  <g color={TINTA} fill={TINTA} font-family={sans}>
    <use href="#a-dpi" x="17" y="17" width="36" height="15" />
    <text x="103" y="22" text-anchor="end" font-size="3.6" font-weight="500">{dominio}</text>
    <text x="103" y="27" text-anchor="end" font-size="3.6" font-weight="500">{empresa.email}</text>
    <text x="60" y="41" text-anchor="middle" font-size="4.6" font-weight="500">Distribuidora de alimentos envasados</text>
    <text x="60" y="46.5" text-anchor="middle" font-size="4.6" font-weight="500">en porciones individuales · desde {empresa.desde}</text>
    <text x="60" y="55" text-anchor="middle" font-size="4" font-weight="700">{nombres.slice(0, mitad).join(' · ')}</text>
    <text x="60" y="60" text-anchor="middle" font-size="4" font-weight="700">{nombres.slice(mitad).join(' · ')}</text>
    <text x="60" y="72" text-anchor="middle" font-size="7.2" font-weight="700" letter-spacing="0.3">TEL.: {telefonoCorto()}</text>
    <text x="60" y="78.5" text-anchor="middle" font-size="3.6">{empresa.direccion.calle} · {empresa.direccion.localidad}</text>
  </g>
</svg>

<style>
  .a-dorso {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
