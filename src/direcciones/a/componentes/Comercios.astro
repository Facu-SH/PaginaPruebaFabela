---
// Comercios: kioscos, bares, almacenes. Sin mínimo en Capital, el sobrecito del café y el del pancho.
import { empresa, productoPorSlug, productosPorCategoria } from '../../../data';
import { waLink } from '../../../lib/whatsapp';
import { capitalizar, listaConY, minuscula, nombreDe, zonaCapital } from '../lib/textos';
import Escena from './Escena.astro';

const capital = zonaCapital();
const azucar = productoPorSlug('azucar');
const aderezos = productosPorCategoria('aderezos');
const marcasAderezos = [...new Set(aderezos.map((p) => p.marca).filter(Boolean))];
---
<section id="comercios" class="comercios" aria-labelledby="comercios-titulo">
  <div class="a-caja comercios__caja">
    <header class="comercios__cabeza">
      <p class="a-ante">Kioscos, bares, almacenes y confiterías</p>
      <h2 id="comercios-titulo">{capitalizar(capital.pedidoMinimo)} en {capital.zona}</h2>
    </header>

    <div class="comercios__texto">
      <p class="a-bajada">
        Pedí lo que uses, aunque sea poco: te llega {capital.plazo}. El pedido típico de un bar o un kiosco es
        {` ${nombreDe('edulcorante')} y ${nombreDe('mayonesa')}`}.
      </p>
      <a class="a-boton" href={waLink('comercio')}>Escribinos desde tu comercio</a>
    </div>

    <figure class="vineta">
      <Escena escena="cafe" />
      <figcaption>
        <h3>Edulcorante en sobre para el café</h3>
        <p>
          El {nombreDe('edulcorante')} de línea propia {empresa.nombreComercial} y el {nombreDe('azucar')}
          {azucar?.marca ? ` ${azucar.marca}` : ''} que acompañan el pocillo.
        </p>
      </figcaption>
    </figure>

    <figure class="vineta">
      <Escena escena="pancho" />
      <figcaption>
        <h3>Mayonesa en sobre para el pancho</h3>
        <p>
          {capitalizar(listaConY(aderezos.map((p) => minuscula(p.nombre))))}
          {marcasAderezos.length ? ` ${marcasAderezos.join(' y ')}` : ''}, para el pancho o la hamburguesa.
        </p>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .comercios {
    background: var(--verde-claro);
    border-block: 3px solid var(--tinta);
    padding-block: clamp(3.5rem, 2rem + 5vw, 7rem);
  }
  .comercios__caja {
    display: grid;
    gap: 2.25rem;
  }
  .comercios__cabeza h2 {
    margin-top: 0.6rem;
    font-size: clamp(2.6rem, 1.4rem + 5vw, 5.6rem);
    font-style: italic;
    font-weight: 600;
    line-height: 0.98;
    max-width: 11em;
  }
  .comercios__texto .a-boton {
    margin-top: 1.4rem;
  }
  .vineta {
    margin: 0;
  }
  .vineta figcaption {
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: var(--filete) solid var(--tinta);
  }
  .vineta h3 {
    font-size: 1.4rem;
  }
  .vineta p {
    margin-top: 0.35rem;
    font-size: 1.0625rem;
  }

  @media (min-width: 64rem) {
    .comercios__caja {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 3rem;
      row-gap: 3rem;
      align-items: start;
    }
    .comercios__cabeza {
      grid-column: 1 / -1;
    }
    .comercios__texto {
      grid-column: 1 / span 4;
      align-self: start;
    }
    .vineta {
      grid-column: span 4;
    }
  }
</style>
