---
// Entregas: "¿Qué día llegamos a tu zona?". Sin JS se ven todas las zonas;
// con JS aparece el selector y se muestra solo la zona elegida.
import { empresa, entregas, horario } from '../../../data';
import { nombreDia, textoHorario } from '../../../lib/horario';
import { waLink } from '../../../lib/whatsapp';
import { capitalizar, diaCorto, diasDeReparto, hayReparto, minuscula, zonaCorta } from '../lib/textos';

const atiende = empresa.whatsapp.atiende;
const zonas = entregas.map((z) => ({
  ...z,
  diasTexto: capitalizar(diasDeReparto(z)),
  semana: z.dias === 'consultar' ? [] : horario.dias.map((d) => ({ d, si: hayReparto(z, d) })),
  // Para "Otras zonas" el mensaje dice "otra zona", así Diego pregunta cuál.
  mensaje: z.dias === 'consultar' ? waLink('zona', { zona: 'otra zona' }) : waLink('zona', { zona: z.zona }),
  boton: z.dias === 'consultar' ? `Preguntale a ${atiende} por tu zona` : `Preguntale a ${atiende} por ${zonaCorta(z)}`,
}));
---
<section id="entregas" class="entregas" aria-labelledby="entregas-titulo">
  <div class="a-caja entregas__caja">
    <div class="entregas__texto">
      <p class="a-ante entregas__ante">Repartos desde {empresa.direccion.localidad}</p>
      <h2 id="entregas-titulo">¿Qué día llegamos a tu zona?</h2>
      <p class="a-bajada entregas__bajada">Elegí tu zona y te decimos qué día pasamos y si hay pedido mínimo.</p>

      <fieldset class="elegir" data-a-zonas-elegir hidden>
        <legend class="visually-hidden">Tu zona</legend>
        {zonas.map((z, i) => (
          <label class="elegir__opcion">
            <input type="radio" name="a-zona" value={z.id} checked={i === 0} />
            <span>{z.zona}</span>
          </label>
        ))}
      </fieldset>
    </div>

    <ul class="zonas" data-a-zonas aria-live="polite">
      {zonas.map((z) => (
        <li class="zona" id={`zona-${z.id}`} data-zona={z.id}>
          <div class="zona__cabeza">
            <h3 class="zona__nombre">{z.zona}</h3>
            {z.detalle && <p class="zona__detalle">{capitalizar(z.detalle)}</p>}
          </div>
          <p class="zona__dias">{z.diasTexto}</p>
          {z.semana.length > 0 && (
            <ol class="semana" aria-label="Días de reparto en la semana">
              {z.semana.map(({ d, si }) => (
                <li class:list={['semana__dia', { 'semana__dia--si': si }]}>
                  <span aria-hidden="true">{diaCorto(d)}</span>
                  <span class="visually-hidden">{`${nombreDia(d)}: ${si ? 'hay reparto' : 'no hay reparto'}`}</span>
                </li>
              ))}
            </ol>
          )}
          <dl class="zona__datos">
            {z.plazo && (
              <div>
                <dt>Plazo</dt>
                <dd>{capitalizar(z.plazo)}</dd>
              </div>
            )}
            <div>
              <dt>Pedido mínimo</dt>
              <dd>{capitalizar(z.pedidoMinimo)}</dd>
            </div>
          </dl>
          <a class="a-boton zona__boton" href={z.mensaje}>{z.boton}</a>
        </li>
      ))}
    </ul>

    {horario.retiroEnDeposito && (
      <p class="entregas__retiro">
        <strong>¿Estás cerca?</strong> Podés retirar en el depósito, {empresa.direccion.calle},
        {` ${empresa.direccion.localidad}`}: {minuscula(textoHorario())}. Avisanos antes por WhatsApp y lo dejamos
        preparado.
      </p>
    )}
  </div>
</section>

<script>
  const elegir = document.querySelector<HTMLFieldSetElement>('[data-a-zonas-elegir]');
  const lista = document.querySelector<HTMLUListElement>('[data-a-zonas]');
  if (elegir && lista) {
    const mostrar = (id: string) => {
      lista.querySelectorAll<HTMLLIElement>('[data-zona]').forEach((li) => {
        li.hidden = li.dataset.zona !== id;
      });
    };
    elegir.hidden = false;
    lista.classList.add('zonas--una');
    elegir.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.name === 'a-zona') mostrar(input.value);
    });
    mostrar(elegir.querySelector<HTMLInputElement>('input:checked')?.value ?? '');
  }
</script>

<style>
  .entregas {
    --foco: var(--papel-claro);
    background: var(--tinta);
    color: var(--papel);
    padding-block: clamp(3.5rem, 2rem + 5vw, 7rem);
  }
  .entregas__caja {
    display: grid;
    gap: 2.25rem;
  }
  .entregas__ante {
    color: var(--kraft-claro);
  }
  .entregas h2 {
    margin-top: 0.6rem;
  }
  .entregas__bajada {
    margin-top: 1rem;
  }

  /* Selector de zona: etiquetas de papel, la elegida queda "pegada" */
  .elegir {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.6rem 0 0;
    padding: 0;
    border: 0;
  }
  .elegir[hidden] {
    display: none;
  }
  .elegir__opcion {
    position: relative;
    cursor: pointer;
  }
  .elegir__opcion input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .elegir__opcion span {
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0.45rem 1rem;
    border: var(--filete) solid color-mix(in srgb, var(--papel) 70%, transparent);
    border-radius: 10px;
    font-family: var(--sans);
    font-weight: 500;
    font-size: 1.0625rem;
    color: var(--papel);
    transition: background-color 0.15s ease;
  }
  .elegir__opcion:hover span {
    background: color-mix(in srgb, var(--papel) 12%, transparent);
  }
  .elegir__opcion input:checked + span {
    background: var(--papel-claro);
    border-color: var(--papel-claro);
    color: var(--tinta);
    font-weight: 700;
  }
  .elegir__opcion input:focus-visible + span {
    outline: 3px solid var(--papel-claro);
    outline-offset: 3px;
  }

  .entregas__retiro {
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--papel) 35%, transparent);
    font-size: 1.0625rem;
    max-width: 34em;
  }

  /* Zonas: hojas de almanaque */
  .zonas {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .zona {
    padding: 1.4rem 1.2rem 1.3rem;
    background: var(--papel-claro);
    color: var(--tinta);
    border-radius: var(--radio);
    box-shadow:
      inset 0 0 0 6px var(--papel-claro),
      inset 0 0 0 7.5px var(--tinta);
  }
  .zona[hidden] {
    display: none;
  }
  .zona__cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
  }
  .zona__nombre {
    font-size: 1.35rem;
  }
  .zona__detalle {
    font-style: italic;
    color: var(--tinta-suave);
  }
  .zona__dias {
    margin-top: 0.6rem;
    font-size: clamp(2.1rem, 1.5rem + 2.5vw, 3.4rem);
    font-weight: 650;
    font-style: italic;
    line-height: 1;
    color: var(--rojo);
    font-variant-numeric: lining-nums;
  }

  /* La semana: el día de reparto lleva el sello rojo */
  .semana {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.35rem;
    margin-top: 1.1rem;
    padding: 0;
    list-style: none;
  }
  .semana__dia {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    max-width: 4.2rem;
    font-family: var(--versalitas);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--tinta-suave);
  }
  .semana__dia--si {
    color: var(--rojo);
    font-weight: 700;
  }
  .semana__dia--si::before,
  .semana__dia--si::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    border: 2.5px solid var(--rojo);
    inset: 8%;
    transform: rotate(-8deg) scaleX(1.06);
  }
  .semana__dia--si::after {
    inset: 18%;
    border-width: 1px;
  }

  .zona__datos {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .zona__datos div {
    display: grid;
    gap: 0.05rem;
    padding-top: 0.5rem;
    border-top: 1px solid color-mix(in srgb, var(--tinta) 25%, transparent);
  }
  .zona__datos dt {
    font-family: var(--versalitas);
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--tinta-suave);
  }
  .zona__datos dd {
    margin: 0;
    font-size: 1.125rem;
  }
  .zona .zona__boton {
    margin-top: 1.2rem;
    width: 100%;
  }

  @media (min-width: 40rem) {
    .zonas:not(.zonas--una) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .entregas__caja {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      column-gap: 4.5rem;
      row-gap: 1.75rem;
      align-items: start;
    }
    .entregas__texto {
      grid-row: 1 / span 2;
    }
    .zonas,
    .entregas__retiro {
      grid-column: 2;
    }
    .elegir {
      flex-direction: column;
      align-items: flex-start;
    }
    .zona {
      padding: 2rem 2rem 1.8rem;
    }
    .zonas--una .zona__datos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
    .zonas--una .zona__boton {
      width: auto;
    }
  }
</style>
