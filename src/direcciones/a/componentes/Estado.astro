---
// "Atendiendo ahora": sin JS muestra el horario; con JS calcula el estado en hora de Buenos Aires.
// - "completo": título y detalle ("Estamos atendiendo · contestamos en minutos").
// - "corto": para el encabezado y el botón flotante.
import { textoHorario } from '../../../lib/horario';

interface Props {
  variante?: 'completo' | 'corto';
  class?: string;
}
const { variante = 'completo', class: clase } = Astro.props;
---
<p class:list={['a-estado', `a-estado--${variante}`, clase]} data-a-estado={variante}>
  <span class="a-estado__punto" aria-hidden="true"></span>
  <span class="a-estado__texto">
    <span data-a-estado-titulo>{textoHorario()}</span><span class="a-estado__detalle" data-a-estado-detalle hidden></span>
  </span>
</p>

<script>
  import { estadoAtencion } from '../../../lib/horario';

  function pintar() {
    const e = estadoAtencion();
    const hora = e.titulo.match(/\d{1,2}:\d{2}/)?.[0] ?? '';
    document.querySelectorAll<HTMLElement>('[data-a-estado]').forEach((nodo) => {
      const titulo = nodo.querySelector<HTMLElement>('[data-a-estado-titulo]');
      const detalle = nodo.querySelector<HTMLElement>('[data-a-estado-detalle]');
      if (!titulo || !detalle) return;
      nodo.dataset.abierto = String(e.abierto);
      if (nodo.dataset.aEstado === 'corto' || nodo.dataset.aEstado === 'punto') {
        titulo.textContent = e.abierto ? 'Atendiendo ahora' : `Abrimos ${e.proximaApertura} a las ${hora}`;
        detalle.hidden = true;
      } else {
        titulo.textContent = e.titulo;
        detalle.textContent = ` · ${e.detalle}`;
        detalle.hidden = false;
      }
    });
  }

  pintar();
  // Se actualiza cada minuto por si la página queda abierta (por ejemplo, a las 4:59).
  setInterval(pintar, 60_000);
</script>

<style>
  .a-estado {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55em;
    font-family: var(--sans);
    font-weight: 500;
    line-height: 1.3;
  }
  .a-estado__punto {
    flex: none;
    width: 0.62em;
    height: 0.62em;
    border-radius: 50%;
    border: 2px solid currentColor;
    transform: translateY(-0.02em);
  }
  /* Abierto: punto lleno en verde. Cerrado: anillo vacío. Sin JS: anillo neutro. */
  [data-abierto='true'] .a-estado__punto {
    background: var(--verde-vivo);
    border-color: var(--verde-vivo);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--verde-vivo) 22%, transparent);
  }
  [data-abierto='false'] .a-estado__punto {
    border-color: var(--rojo);
  }
  .a-estado--corto {
    font-size: 0.9375rem;
  }
  .a-estado__detalle {
    font-weight: 400;
  }
</style>
