---
// Escenas de comercio: el pocillo de café con sus sobrecitos y el pancho con sus aderezos.
// Fondo en SVG + envases encima. Decorativas: el texto de al lado dice lo mismo.
import Envase from './Envase.astro';

interface Props {
  escena: 'cafe' | 'pancho';
  class?: string;
}
const { escena, class: clase } = Astro.props;
const TINTA = '#1C2230';
const PAPEL = '#FBF8F1';
const linea = { stroke: TINTA, 'stroke-width': 1.4, 'vector-effect': 'non-scaling-stroke', 'stroke-linejoin': 'round', fill: 'none' } as const;
// Mayonesa en zigzag sobre la salchicha
const zig = Array.from({ length: 17 }, (_, i) => `${i === 0 ? 'M' : 'L'}${44 + i * 13} ${123 + (i % 2 ? -6 : 6)}`).join('');
---
<div class:list={['escena', `escena--${escena}`, clase]} aria-hidden="true">
  {escena === 'cafe' ? (
    <svg class="escena__fondo" viewBox="0 0 300 230" focusable="false">
      <g transform="translate(2 2)">
        <circle cx="172" cy="116" r="86" fill={PAPEL} />
        <rect x="214" y="107" width="38" height="17" rx="8.5" fill={PAPEL} />
        <circle cx="172" cy="116" r="50" fill={PAPEL} />
        <circle cx="172" cy="116" r="42" fill="#5E3B22" />
        <ellipse cx="160" cy="104" rx="15" ry="7" fill="#8A5A35" opacity="0.8" transform="rotate(-28 160 104)" />
        <ellipse cx="148" cy="190" rx="10" ry="6.5" fill="#D9D6CE" transform="rotate(-6 148 190)" />
        <path d="M157 189L226 182" stroke="#D9D6CE" stroke-width="5" stroke-linecap="round" />
      </g>
      <circle cx="172" cy="116" r="86" {...linea} />
      <circle cx="172" cy="116" r="61" {...linea} opacity="0.35" />
      <path d="M220 107H243.5A8.5 8.5 0 0 1 243.5 124H220" {...linea} />
      <circle cx="172" cy="116" r="50" {...linea} />
      <circle cx="172" cy="116" r="42" {...linea} opacity="0.5" />
      <ellipse cx="148" cy="190" rx="10" ry="6.5" transform="rotate(-6 148 190)" {...linea} />
      <path d="M157.5 186.6L226 180" {...linea} />
    </svg>
  ) : (
    <svg class="escena__fondo" viewBox="0 0 300 230" focusable="false">
      <g transform="translate(2 2)">
        <path d="M58 34L246 20L262 196L74 212Z" fill={PAPEL} />
        <g transform="rotate(-7 150 123)">
          <rect x="22" y="110" width="256" height="26" rx="13" fill="#B4553B" />
          <rect x="40" y="94" width="220" height="60" rx="30" fill="#D9A35F" />
          <rect x="52" y="108" width="196" height="32" rx="16" fill="#EAC283" />
          <rect x="22" y="110" width="256" height="26" rx="13" fill="#B4553B" />
          <path d={zig} fill="none" stroke="#F2D45C" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </g>
      <path d="M58 34L246 20L262 196L74 212Z" {...linea} />
      <path d="M58 34L104 70M216 160L262 196" {...linea} opacity="0.18" />
      <g transform="rotate(-7 150 123)">
        <path d="M40 124A30 30 0 0 1 70 94H230A30 30 0 0 1 260 124" {...linea} />
        <path d="M40 124A30 30 0 0 0 70 154H230A30 30 0 0 0 260 124" {...linea} />
        <rect x="22" y="110" width="256" height="26" rx="13" {...linea} />
      </g>
    </svg>
  )}

  {escena === 'cafe' ? (
    <Fragment>
      <span class="escena__envase escena__envase--1"><Envase clave="edulcorante" /></span>
      <span class="escena__envase escena__envase--2"><Envase clave="azucar" /></span>
    </Fragment>
  ) : (
    <Fragment>
      <span class="escena__envase escena__envase--1"><Envase clave="mayonesa" /></span>
      <span class="escena__envase escena__envase--2"><Envase clave="ketchup" /></span>
    </Fragment>
  )}
</div>

<style>
  .escena {
    position: relative;
    aspect-ratio: 300 / 230;
    width: 100%;
  }
  .escena__fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .escena__envase {
    position: absolute;
    display: block;
    filter: drop-shadow(0 6px 6px rgb(28 34 48 / 0.18));
  }
  .escena--cafe .escena__envase--1 {
    left: -2%;
    top: 2%;
    width: 38%;
    transform: rotate(-14deg);
  }
  .escena--cafe .escena__envase--2 {
    left: 3%;
    top: 55%;
    width: 31%;
    transform: rotate(10deg);
  }
  .escena--pancho .escena__envase--1 {
    left: 77%;
    top: -6%;
    width: 13%;
    transform: rotate(24deg);
  }
  .escena--pancho .escena__envase--2 {
    left: 6%;
    top: 60%;
    width: 13%;
    transform: rotate(-58deg);
  }
</style>
