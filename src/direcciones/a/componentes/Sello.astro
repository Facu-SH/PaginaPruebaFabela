---
// Sello de goma redondo: doble anillo, texto en arco y un dato grande al centro.
// Es decorativo: el mismo dato tiene que estar escrito en el texto de la página.
interface Props {
  id: string;
  arriba: string;
  abajo: string;
  centro: string;
  centroChico?: string;
  class?: string;
}
const { id, arriba, abajo, centro, centroChico, class: clase } = Astro.props;
const serif = "'Alegreya Variable', Alegreya, Georgia, serif";
const versalitas = "'Alegreya SC', 'Alegreya Variable', Georgia, serif";
---
<svg class:list={['a-sello', clase]} viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  <defs>
    <path id={`${id}-arriba`} d="M27 100A73 73 0 0 1 173 100" />
    <path id={`${id}-abajo`} d="M19 100A81 81 0 0 0 181 100" />
  </defs>
  <g fill="none" stroke="currentColor">
    <circle cx="100" cy="100" r="96" stroke-width="4" />
    <circle cx="100" cy="100" r="88" stroke-width="1.4" />
    <circle cx="100" cy="100" r="61" stroke-width="1.2" />
  </g>
  <g fill="currentColor">
    <text font-family={versalitas} font-weight="700" font-size="15.5" letter-spacing="1.2">
      <textPath href={`#${id}-arriba`} startOffset="50%" text-anchor="middle">{arriba}</textPath>
    </text>
    <text font-family={versalitas} font-weight="700" font-size="15" letter-spacing="1.1">
      <textPath href={`#${id}-abajo`} startOffset="50%" text-anchor="middle">{abajo}</textPath>
    </text>
    <circle cx="20.5" cy="100" r="3" />
    <circle cx="179.5" cy="100" r="3" />
    <text x="100" y={centroChico ? 109 : 117} text-anchor="middle" font-family={serif} font-weight="800" font-size="44" letter-spacing="-0.5">{centro}</text>
    {centroChico && (
      <text x="100" y="131" text-anchor="middle" font-family={serif} font-style="italic" font-weight="500" font-size="15">{centroChico}</text>
    )}
  </g>
</svg>

<style>
  .a-sello {
    display: block;
    width: 100%;
    height: auto;
    color: var(--rojo);
    mix-blend-mode: multiply;
  }
</style>
