---
// Dibujo de un envase según su formato real. Estilo: línea de tinta + color de producto
// levemente fuera de registro, como una impresión a dos tintas.
// No lleva logos de marcas ajenas: la marca va como texto al lado. Solo el sobre propio
// de edulcorante lleva la marca DPI.
import { empresa } from '../../../data';
import { dibujoDe } from '../envases';
import { lineaDentada, lineaDentadaVertical, rectanguloDentado } from '../lib/dentado';
import { telefonoCorto } from '../lib/textos';

interface Props {
  /** Slug del producto o "slug:variante" (por ejemplo "mermeladas:durazno"). */
  clave: string;
  class?: string;
  /** Si se pasa, el dibujo se anuncia con este texto; si no, es decorativo. */
  etiqueta?: string;
  /** Sin desfase de registro (para tamaños muy chicos). */
  registro?: boolean;
}
const { clave, class: clase, etiqueta, registro = false } = Astro.props;
const dibujo = dibujoDe(clave);
if (!dibujo) throw new Error(`Envase sin dibujo: ${clave}`);

const TINTA = '#1C2230';
const PAPEL = '#FBF8F1';
const linea = { stroke: TINTA, 'stroke-width': 1.4, 'vector-effect': 'non-scaling-stroke', 'stroke-linejoin': 'round', fill: 'none' } as const;
const fina = { stroke: TINTA, 'stroke-width': 0.8, 'vector-effect': 'non-scaling-stroke', fill: 'none' } as const;

const rango = (desde: number, hasta: number, paso: number) => {
  const r: number[] = [];
  for (let v = desde; v <= hasta + 0.001; v += paso) r.push(+v.toFixed(2));
  return r;
};

// Medidas por formato
let viewBox = '0 0 60 124';
let desfase = 1.1;
if (dibujo.tipo === 'papel') {
  viewBox = '0 0 120 96';
  desfase = 1.5;
} else if (dibujo.tipo === 'pote') {
  viewBox = '0 0 80 74';
  desfase = 1.2;
} else if (dibujo.tipo === 'paquete') {
  viewBox = dibujo.contenido === 'vainillas' ? '0 0 150 42' : '0 0 132 58';
  desfase = 1.5;
}
const d = registro ? 0 : desfase;

// Almohadilla
const selloArriba = `${lineaDentada(4, 56, 4, 3.5, 1.8, true)}L56 19L4 19Z`;
const selloAbajo = `${lineaDentada(4, 56, 120, 3.5, 1.8, false)}L56 105L4 105Z`;
const pliegues = rango(7, 53, 3);

// Papel
const bordePapel = rectanguloDentado(3, 3, 114, 90, 5, 2.4);
const crimpX = rango(7, 113, 2.6);
const crimpY = rango(7, 89, 2.6);

// Paquete
const P = dibujo.tipo === 'paquete' ? dibujo : null;
const W = P?.contenido === 'vainillas' ? 150 : 132;
const H = P?.contenido === 'vainillas' ? 42 : 58;
const ventana = { x: W * 0.3, y: H * 0.4, w: W * 0.4, h: H * 0.42 };
const selloIzq = `${lineaDentadaVertical(4, H - 4, 4, 3.4, 1.8, true)}L15 ${H - 4}L15 4Z`;
const selloDer = `${lineaDentadaVertical(4, H - 4, W - 4, 3.4, 1.8, false)}L${W - 15} ${H - 4}L${W - 15} 4Z`;
const pliegueY = rango(7, H - 7, 2.6);
---
<svg
  class:list={['a-envase', `a-envase--${dibujo.tipo}`, clase]}
  viewBox={viewBox}
  role={etiqueta ? 'img' : undefined}
  aria-label={etiqueta}
  aria-hidden={etiqueta ? undefined : 'true'}
  focusable="false"
>
  {dibujo.tipo === 'almohadilla' && (
    <Fragment>
      <g transform={`translate(${d} ${d})`}>
        <rect x="6" y="12" width="48" height="100" rx="8" fill={dibujo.color} />
        <path d={selloArriba} fill={dibujo.sello} />
        <path d={selloAbajo} fill={dibujo.sello} />
        <rect x="11" y="26" width="5" height="72" rx="2.5" fill="#fff" opacity="0.4" />
        <rect x="19" y="40" width="24" height="46" rx="12" fill={dibujo.salsa} />
      </g>
      <rect x="6" y="12" width="48" height="100" rx="8" {...linea} />
      <path d={selloArriba} {...linea} />
      <path d={selloAbajo} {...linea} />
      <path d={pliegues.map((x) => `M${x} 6V17M${x} 107V118`).join('')} {...fina} opacity="0.3" />
      <rect x="19" y="40" width="24" height="46" rx="12" {...linea} opacity="0.55" />
    </Fragment>
  )}

  {dibujo.tipo === 'papel' && (
    <Fragment>
      <g transform={`translate(${d} ${d})`}>
        <path d={bordePapel} fill={PAPEL} />
        {dibujo.impresion === 'dpi' && (
          <path d="M3 60C28 50 52 74 80 56S108 22 117 20L117 93L3 93Z" fill="#CFE3C2" />
        )}
      </g>
      <path d={bordePapel} {...linea} />
      <path
        d={[
          ...crimpX.map((x) => `M${x} 5V9.5M${x} 86.5V91`),
          ...crimpY.map((y) => `M5 ${y}H9.5M110.5 ${y}H115`),
        ].join('')}
        {...fina}
        opacity="0.2"
      />
      {dibujo.impresion === 'dpi' ? (
        <g color={TINTA}>
          <use href="#a-dpi" x="16" y="14" width="64" height="26.6" />
          <text x="60" y="63" text-anchor="middle" fill={TINTA} font-family="'Alegreya Sans', system-ui, sans-serif" font-weight="700" font-size="8.6" letter-spacing="2.4">EDULCORANTE</text>
          <text x="60" y="75" text-anchor="middle" fill={TINTA} font-family="'Alegreya Sans', system-ui, sans-serif" font-weight="500" font-size="6.4">Tel. {telefonoCorto()}</text>
          <text x="60" y="83" text-anchor="middle" fill={TINTA} font-family="'Alegreya Sans', system-ui, sans-serif" font-size="5.2">{empresa.email}</text>
        </g>
      ) : (
        <g>
          <rect x="14" y="14" width="92" height="68" rx="9" fill="none" stroke="#24527F" stroke-width="1.2" vector-effect="non-scaling-stroke" />
          <text x="60" y="53" text-anchor="middle" fill={TINTA} font-family="'Alegreya Variable', Alegreya, Georgia, serif" font-style="italic" font-weight="600" font-size="19">Azúcar</text>
          <path d="M42 61H78" stroke="#24527F" stroke-width="1" vector-effect="non-scaling-stroke" />
        </g>
      )}
    </Fragment>
  )}

  {dibujo.tipo === 'pote' && (
    <Fragment>
      <g transform={`translate(${d} ${d})`}>
        <path d="M9 27L71 27L66.5 65Q66 70 61 70L19 70Q14 70 13.5 65Z" fill={dibujo.cuerpo} />
        {!dibujo.opaco && <path d="M17 31L22 31L20.4 63L17.6 63Z" fill="#fff" opacity="0.32" />}
        {dibujo.opaco && <path d="M17 31L21 31L19.6 63L17.6 63Z" fill="#fff" opacity="0.5" />}
        <rect x="5" y="21" width="70" height="7" rx="2" fill={dibujo.opaco ? dibujo.cuerpo : '#F1ECE2'} />
        <path d="M5 21L75 21L69 9L11 9Z" fill={dibujo.tapa} />
        <path d="M15 19L65 19L61.5 11.5L18.5 11.5Z" fill={dibujo.impresion} />
        <path d="M69 9L77 5L79.4 11L74 15Z" fill={dibujo.tapa} />
      </g>
      <path d="M9 28L71 28L66.5 65Q66 70 61 70L19 70Q14 70 13.5 65Z" {...linea} />
      <rect x="5" y="21" width="70" height="7" rx="2" {...linea} />
      <path d="M5 21L75 21L69 9L11 9Z" {...linea} />
      <path d="M69 9L77 5L79.4 11L74 15" {...linea} />
    </Fragment>
  )}

  {P && (
    <Fragment>
      <g transform={`translate(${d} ${d})`}>
        <rect x="12" y="5" width={W - 24} height={H - 10} rx="5" fill={P.fondo} />
        <rect x="12" y="5" width={W - 24} height={(H - 10) * 0.26} fill={P.banda} />
        <rect x="12" y={H - 9} width={W - 24} height="4" fill={P.banda} />
        <path d={selloIzq} fill={P.banda} />
        <path d={selloDer} fill={P.banda} />
        <rect x={ventana.x} y={ventana.y} width={ventana.w} height={ventana.h} rx="4" fill="#FBF3E2" />
        {P.contenido === 'galletitas' &&
          [0.2, 0.5, 0.8].map((t) => (
            <Fragment>
              <circle cx={ventana.x + ventana.w * t} cy={ventana.y + ventana.h / 2} r={ventana.h * 0.36} fill="#D9A55E" />
              <circle cx={ventana.x + ventana.w * t - 2} cy={ventana.y + ventana.h / 2 - 1.5} r="0.9" fill="#9C6A2C" />
              <circle cx={ventana.x + ventana.w * t + 2} cy={ventana.y + ventana.h / 2 + 1.5} r="0.9" fill="#9C6A2C" />
            </Fragment>
          ))}
        {P.contenido === 'tostadas' &&
          [0.27, 0.73].map((t) => (
            <Fragment>
              <rect x={ventana.x + ventana.w * t - ventana.h * 0.42} y={ventana.y + ventana.h * 0.1} width={ventana.h * 0.84} height={ventana.h * 0.8} rx="3" fill="#C98A47" />
              <rect x={ventana.x + ventana.w * t - ventana.h * 0.3} y={ventana.y + ventana.h * 0.22} width={ventana.h * 0.6} height={ventana.h * 0.56} rx="2" fill="#EBC27F" />
            </Fragment>
          ))}
        {P.contenido === 'vainillas' &&
          [0.33, 0.66].map((t) => (
            <ellipse cx={ventana.x + ventana.w / 2} cy={ventana.y + ventana.h * t} rx={ventana.w * 0.42} ry={ventana.h * 0.2} fill="#E8C467" />
          ))}
      </g>
      <rect x="12" y="5" width={W - 24} height={H - 10} rx="5" {...linea} />
      <path d={selloIzq} {...linea} />
      <path d={selloDer} {...linea} />
      <path d={pliegueY.map((y) => `M6 ${y}H13M${W - 13} ${y}H${W - 6}`).join('')} {...fina} opacity="0.3" />
      <rect x={ventana.x} y={ventana.y} width={ventana.w} height={ventana.h} rx="4" {...linea} opacity="0.6" />
    </Fragment>
  )}
</svg>

<style>
  .a-envase {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
