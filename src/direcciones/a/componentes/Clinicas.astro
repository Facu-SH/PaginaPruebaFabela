---
// Clínicas e instituciones: "una porción para cada comida" como una bandeja de cuatro huecos,
// uno por comida, con las porciones dibujadas. Sale de comidasClinica.
import { comidasClinica, empresa, pagos, productoPorSlug } from '../../../data';
import { waLink } from '../../../lib/whatsapp';
import { dibujoDe } from '../envases';
import { listaConY, minuscula } from '../lib/textos';
import Envase from './Envase.astro';

interface Porcion {
  clave: string;
  nombre: string;
  tipo: string;
}
const huecos = comidasClinica.map((m) => {
  const porciones: Porcion[] = [];
  for (const slug of m.productos) {
    const p = productoPorSlug(slug);
    if (!p) continue;
    const clave = p.variantes ? `${p.slug}:${p.variantes[0]}` : p.slug;
    const d = dibujoDe(clave);
    if (d) porciones.push({ clave, nombre: minuscula(p.nombre), tipo: d.tipo });
  }
  return { comida: m.comida, porciones };
});
const facturaA = pagos.facturacion.find((f) => f.includes('A'));
---
<section id="clinicas" class="clinicas a-caja" aria-labelledby="clinicas-titulo">
  <div class="clinicas__texto">
    <p class="a-ante">Clínicas, geriátricos e instituciones</p>
    <h2 id="clinicas-titulo">Una porción para cada comida</h2>
    <p class="a-bajada">
      Las clínicas nos piden de todo un poco, porque dan algo en cada comida: lo del desayuno y la merienda, y los
      aderezos del almuerzo y la cena.
    </p>
    <p class="clinicas__dato">
      {facturaA && <Fragment>Hacemos {facturaA} y trabajamos con </Fragment>}{pagos.instituciones}.
    </p>
    <a class="a-boton" href={waLink('clinica')}>Escribinos desde la clínica</a>
  </div>

  <figure class="bandeja-figura">
    <ol class="bandeja" aria-label="Qué lleva cada comida">
      {huecos.map((h, i) => (
        <li class="bandeja__hueco" style={`--i: ${i}`}>
          <h3 class="bandeja__comida">{h.comida}</h3>
          <div class="bandeja__porciones" aria-hidden="true">
            {h.porciones.map((p) => (
              <span class={`bandeja__porcion bandeja__porcion--${p.tipo}`}>
                <Envase clave={p.clave} registro />
              </span>
            ))}
          </div>
          <p class="bandeja__lista">{listaConY(h.porciones.map((p) => p.nombre))}</p>
        </li>
      ))}
    </ol>
    <figcaption class="bandeja-figura__pie">
      La bandeja de un día en una clínica, con productos que reparte {empresa.nombreComercial}.
    </figcaption>
  </figure>
</section>

<style>
  .clinicas {
    display: grid;
    gap: 2.25rem;
    padding-block: clamp(3.5rem, 2rem + 5vw, 7rem);
  }
  .clinicas__texto h2 {
    margin-top: 0.6rem;
  }
  .clinicas__texto .a-bajada {
    margin-top: 1rem;
  }
  .clinicas__dato {
    margin-top: 1rem;
    padding-left: 0.9rem;
    border-left: 3px solid var(--rojo);
    font-size: 1.0625rem;
  }
  .clinicas__texto .a-boton {
    margin-top: 1.5rem;
  }

  /* La bandeja: plástico gris cálido con borde levantado y cuatro huecos */
  .bandeja {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 0;
    padding: 0.75rem;
    list-style: none;
    background: #e3ddd0;
    border: var(--filete) solid var(--tinta);
    border-radius: 26px;
    box-shadow:
      inset 0 0 0 5px #ece7dc,
      inset 0 0 0 6px color-mix(in srgb, var(--tinta) 25%, transparent),
      0 14px 24px rgb(28 34 48 / 0.14);
  }
  .bandeja__hueco {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 11rem;
    padding: 0.7rem 0.6rem 0.65rem;
    background: var(--papel-claro);
    border-radius: 16px;
    box-shadow:
      inset 0 3px 8px rgb(28 34 48 / 0.12),
      inset 0 0 0 1px color-mix(in srgb, var(--tinta) 30%, transparent);
  }
  .bandeja__comida {
    font-size: 1.3rem;
    font-style: italic;
    font-weight: 600;
  }
  .bandeja__porciones {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: center;
    justify-content: center;
    gap: 0.35rem 0.4rem;
  }
  .bandeja__porcion {
    display: block;
  }
  .bandeja__porcion:nth-child(3n + 1) {
    transform: rotate(-8deg);
  }
  .bandeja__porcion:nth-child(3n + 2) {
    transform: rotate(5deg);
  }
  .bandeja__porcion--almohadilla {
    width: 1.55rem;
  }
  .bandeja__porcion--papel {
    width: 3.1rem;
  }
  .bandeja__porcion--pote {
    width: 2.35rem;
  }
  .bandeja__porcion--paquete {
    width: 3.6rem;
  }
  .bandeja__lista {
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: 1.25;
    color: var(--tinta-suave);
  }
  .bandeja-figura__pie {
    margin-top: 0.8rem;
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--tinta-suave);
  }

  @media (min-width: 40rem) {
    .bandeja__porcion--almohadilla {
      width: 2rem;
    }
    .bandeja__porcion--papel {
      width: 4rem;
    }
    .bandeja__porcion--pote {
      width: 3rem;
    }
    .bandeja__porcion--paquete {
      width: 4.6rem;
    }
    .bandeja__hueco {
      min-height: 13rem;
      padding: 0.9rem 0.9rem 0.8rem;
    }
  }

  @media (min-width: 64rem) {
    .clinicas {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: 4.5rem;
    }
    .bandeja {
      padding: 1rem;
      gap: 0.8rem;
    }
  }
</style>
