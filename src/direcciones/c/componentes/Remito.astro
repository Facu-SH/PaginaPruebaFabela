---
// El remito: todos los productos como renglones (cantidad · descripción · marca), agrupados
// por categoría con el dibujo de su envase. Con JS, los renglones se marcan y arman un mensaje
// de WhatsApp ("Armá tu consulta"). Sin JS, es una lista completa y el botón abre un pedido genérico.
// Al pie, en el lugar del "total", va la lista de precios: no se publica, se pide.
import { categorias, empresa, entregas, precios, productosPorCategoria } from '../../../data';
import { mailtoLink, waLink } from '../../../lib/whatsapp';
import { FORMATO, colorDe, colorVariante } from '../lib';
import Envase from './Envase.astro';

const atiende = empresa.whatsapp.atiende;
const grupos = categorias.map((c) => ({ c, items: productosPorCategoria(c.slug) }));
---
<form class="dc-remito" id="dc-consulta" aria-labelledby="dc-remito-h" data-dc-consulta>
  <header class="dc-remito__cabecera">
    <div>
      <p class="dc-etiqueta">Remito de mercadería<span class="dc-solo-js"> · Armá tu consulta</span></p>
      <h2 class="dc-h2" id="dc-remito-h">Todo lo que despachamos, renglón por renglón</h2>
    </div>
    <p class="dc-remito__ayuda">
      <span class="dc-solo-js">Marcá los renglones que te interesan y, si querés, anotá una cantidad aproximada. Se arma el mensaje y se lo mandás a {atiende} por WhatsApp.</span>
      <span class="dc-solo-sin-js">Pedí cualquiera de estos productos por WhatsApp: te contesta {atiende}.</span>
    </p>
  </header>

  <div class="dc-remito__columnas" aria-hidden="true">
    <span class="dc-solo-js">Marcá</span>
    <span>Descripción</span>
    <span>Marca</span>
    <span class="dc-solo-js">Cant.<span class="dc-largo-col"> aprox.</span></span>
  </div>

  {grupos.map(({ c, items }) => (
    <fieldset class="dc-rubro" aria-labelledby={`dc-rubro-${c.slug}`}>
      <div class="dc-rubro__lado">
        <h3 class="dc-rubro__titulo" id={`dc-rubro-${c.slug}`}>
          <span class="dc-rubro__nombre">{c.nombre}</span>
          <span class="dc-rubro__formato">{FORMATO[c.envase].nombre}{c.frio ? ' · viaja en frío' : ''}</span>
        </h3>
        <Envase tipo={c.envase} color={colorDe(items[0]?.slug ?? '')} class="dc-rubro__dibujo" />
        <p class="dc-rubro__bajada">{c.bajada}</p>
      </div>
      <ul class="dc-rubro__renglones">
        {items.map((p) => (
          <li class="dc-renglon">
            <input
              class="dc-renglon__marca dc-solo-js"
              type="checkbox"
              id={`dc-p-${p.slug}`}
              name="producto"
              value={p.marca ? `${p.nombre} ${p.marca}` : p.nombre}
              data-dc-producto={p.slug}
            />
            <label class="dc-renglon__desc" for={`dc-p-${p.slug}`}>
              <span class="dc-renglon__chip" aria-hidden="true">
                {p.variantes && c.envase === 'pote'
                  ? p.variantes.map((v) => <i style={`background:${colorVariante(v, colorDe(p.slug))}`} />)
                  : <i style={`background:${colorDe(p.slug)}`} />}
              </span>
              <span class="dc-renglon__nombre">
                {p.nombre}
                {p.masVendido && <span class="dc-renglon__mas">más pedido</span>}
              </span>
              {p.variantes && <span class="dc-renglon__variantes">{p.variantes.join(' · ')}</span>}
            </label>
            <span class="dc-renglon__marca-txt">{p.marca ?? '—'}</span>
            <span class="dc-renglon__cant dc-solo-js">
              <label class="visually-hidden" for={`dc-c-${p.slug}`}>Cantidad aproximada de {p.nombre.toLowerCase()}</label>
              <input type="text" id={`dc-c-${p.slug}`} name={`cant-${p.slug}`} autocomplete="off" data-dc-cantidad={p.slug} />
            </span>
          </li>
        ))}
        <li class="dc-renglon dc-renglon--vacio" aria-hidden="true"></li>
      </ul>
    </fieldset>
  ))}

  <div class="dc-renglon dc-renglon--otro">
    <label class="dc-renglon__desc" for="dc-otro">
      <span class="dc-renglon__nombre">¿Buscás algo que no está en el remito? Si no lo ves, preguntanos.</span>
      <span class="dc-renglon__variantes">Trabajamos más productos en porción individual que los que entran acá.</span>
    </label>
    <input class="dc-renglon__linea dc-solo-js" type="text" id="dc-otro" name="otro" autocomplete="off" data-dc-otro />
  </div>

  <div class="dc-remito__pie">
    <div class="dc-remito__datos dc-solo-js">
      <fieldset class="dc-opciones">
        <legend>Es para</legend>
        <label><input type="radio" name="tipo" value="una clínica o institución" data-dc-tipo /> Clínica o institución</label>
        <label><input type="radio" name="tipo" value="un comercio (bar, kiosco, almacén)" data-dc-tipo /> Bar, kiosco o comercio</label>
        <label><input type="radio" name="tipo" value="otro tipo de negocio" data-dc-tipo /> Otro</label>
      </fieldset>
      <label class="dc-campo-select">
        <span>Zona</span>
        <select name="zona" data-dc-zona-consulta>
          <option value="">Elegí tu zona</option>
          {entregas.filter((z) => z.dias !== 'consultar').map((z) => <option value={z.zona}>{z.zona}</option>)}
          <option value="otra zona">Otra zona</option>
        </select>
      </label>
    </div>

    <div class="dc-remito__envio">
      <div class="dc-mensaje dc-solo-js" aria-live="polite">
        <p class="dc-etiqueta">Así le llega a {atiende}</p>
        <p class="dc-mensaje__texto" data-dc-vista>Marcá al menos un renglón y el mensaje se arma solo.</p>
      </div>
      <a class="dc-boton dc-boton--grande" href={waLink('pedido')} data-dc-enviar>
        <span>Mandar la consulta por WhatsApp</span>
        <span class="dc-boton__flecha" aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <section class="dc-total" aria-labelledby="dc-lista-h" id="lista">
    <p class="dc-total__rotulo" aria-hidden="true">Total</p>
    <div class="dc-total__cuerpo">
      <h2 class="dc-total__titulo" id="dc-lista-h">La lista de precios no va en la web: se pide</h2>
      <p>Se actualiza seguido, así que no la publicamos: te mandamos la vigente {precios.comoPedir}.</p>
      <div class="dc-total__botones">
        <a class="dc-boton" href={waLink('lista')}>Pedir la lista por WhatsApp</a>
        <a class="dc-boton dc-boton--papel dc-boton--mail" href={mailtoLink('lista')}>Pedirla por mail <span class="dc-total__mail">{empresa.email}</span></a>
      </div>
    </div>
    <p class="dc-sello dc-total__sello" aria-hidden="true">Lista vigente<br />a pedido</p>
  </section>
</form>
