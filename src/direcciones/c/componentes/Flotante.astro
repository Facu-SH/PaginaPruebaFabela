---
// Botón flotante de WhatsApp (solo celular), con forma de talón troquelado.
// El detalle cambia según el estado (cliente/estado.ts).
import { empresa } from '../../../data';
import { waLink } from '../../../lib/whatsapp';

const atiende = empresa.whatsapp.atiende;
---
<a class="dc-flotante" href={waLink('general')}>
  <svg class="dc-flotante__sol" viewBox="0 0 28 20" aria-hidden="true">
    <clipPath id="dc-flotante-cielo"><rect x="0" y="0" width="28" height="14" /></clipPath>
    <circle class="dc-sol" cx="14" cy="13" r="8" fill="var(--dc-amanecer)" clip-path="url(#dc-flotante-cielo)" />
    <line x1="1" y1="15" x2="27" y2="15" stroke="currentColor" stroke-width="2" />
  </svg>
  <span class="dc-flotante__texto">
    <strong>WhatsApp</strong>
    <span><span data-dc-flotante-detalle>te contesta {atiende}</span></span>
  </span>
</a>
