---
// Dibujo técnico de línea de cada formato real de envase:
//   sobre        -> sobre "almohadilla" alargado, extremos crimpados (aderezos)
//   sobre-papel  -> sobre cuadrado de papel, borde dentado (azúcar, edulcorante)
//   pote         -> potecito con tapa pelable (mermeladas, manteca, queso crema)
//   paquete      -> paquetito flow-pack, sellado en los extremos (galletitas, tostadas, vainillas)
// Sin marcas ajenas: solo forma y color del producto.
import type { Envase } from '../lib';

interface Props {
  tipo: Envase;
  color: string;
  /** "ficha": con detalles (crimpado, muesca, renglones de rótulo). "mini": para celdas de planilla. */
  modo?: 'ficha' | 'mini';
  class?: string;
  /** Si se pasa, el dibujo se anuncia como imagen con este texto; si no, es decorativo. */
  titulo?: string;
}
const { tipo, color, modo = 'ficha', class: clase, titulo } = Astro.props;
const ficha = modo === 'ficha';
const trazo = ficha ? 1.5 : 1.1;

/** Contorno con borde dentado alrededor de un rectángulo (dientes hacia adentro). */
function bordeDentado(x: number, y: number, w: number, h: number, paso: number, amp: number) {
  const pts: string[] = [];
  const lado = (x0: number, y0: number, x1: number, y1: number, nx: number, ny: number) => {
    const largo = Math.hypot(x1 - x0, y1 - y0);
    const n = Math.max(2, Math.round(largo / paso)) * 2;
    for (let i = 0; i < n; i++) {
      const t = i / n;
      const off = i % 2 ? amp : 0;
      pts.push(`${(x0 + (x1 - x0) * t + nx * off).toFixed(2)},${(y0 + (y1 - y0) * t + ny * off).toFixed(2)}`);
    }
  };
  lado(x, y, x + w, y, 0, 1);
  lado(x + w, y, x + w, y + h, -1, 0);
  lado(x + w, y + h, x, y + h, 0, -1);
  lado(x, y + h, x, y, 1, 0);
  return `M${pts.join('L')}Z`;
}

/** Borde en zigzag vertical (para extremos sellados). Devuelve los puntos de arriba hacia abajo. */
function zigzagVertical(x: number, y0: number, y1: number, paso: number, amp: number) {
  const pts: string[] = [];
  const n = Math.round((y1 - y0) / paso) * 2;
  for (let i = 0; i <= n; i++) pts.push(`${(x + (i % 2 ? amp : 0)).toFixed(2)},${(y0 + ((y1 - y0) * i) / n).toFixed(2)}`);
  return pts;
}

const vb = {
  sobre: '0 0 124 46',
  'sobre-papel': '0 0 80 80',
  pote: '0 0 88 70',
  paquete: '0 0 124 58',
}[tipo];

// Sobre almohadilla
const crimpIzq = ['15,7', ...zigzagVertical(3, 6, 40, 3.4, 2.2), '15,39'].join(' ');
const crimpDer = ['109,7', ...zigzagVertical(121, 6, 40, 3.4, -2.2), '109,39'].join(' ');

// Paquete flow-pack
const selloIzq = ['16,8', ...zigzagVertical(3, 7, 51, 3, 2.6), '16,50'].join(' ');
const selloDer = ['108,8', ...zigzagVertical(121, 7, 51, 3, -2.6), '108,50'].join(' ');
---
<svg
  class:list={['dc-envase', `dc-envase--${tipo}`, `dc-envase--${modo}`, clase]}
  viewBox={vb}
  {...(titulo ? { role: 'img', 'aria-label': titulo } : { 'aria-hidden': 'true', focusable: 'false' })}
>
  <g stroke="var(--dc-tinta)" stroke-width={trazo} stroke-linejoin="round" vector-effect="non-scaling-stroke">
    {tipo === 'sobre' && (
      <>
        <polygon points={crimpIzq} fill={color} vector-effect="non-scaling-stroke" />
        <polygon points={crimpDer} fill={color} vector-effect="non-scaling-stroke" />
        <path d="M15 7Q62 3 109 7L109 39Q62 43 15 39Z" fill={color} vector-effect="non-scaling-stroke" />
        {ficha && (
          <g stroke-width="0.7" opacity="0.75">
            {[7, 9.5, 12].map((x) => <line x1={x} y1="8" x2={x} y2="38" vector-effect="non-scaling-stroke" />)}
            {[112, 114.5, 117].map((x) => <line x1={x} y1="8" x2={x} y2="38" vector-effect="non-scaling-stroke" />)}
          </g>
        )}
        {ficha && <path d="M24 11Q62 7.5 100 11" fill="none" stroke="#fff" stroke-width="2" opacity="0.7" stroke-linecap="round" vector-effect="non-scaling-stroke" />}
        {ficha && <path d="M3 6L7 6L5 10Z" fill="var(--dc-papel)" stroke-width="0.8" vector-effect="non-scaling-stroke" />}
      </>
    )}

    {tipo === 'sobre-papel' && (
      <>
        <path d={bordeDentado(3, 3, 74, 74, ficha ? 3.2 : 6, ficha ? 2 : 2.6)} fill={color} vector-effect="non-scaling-stroke" />
        <rect x="11" y="11" width="58" height="58" rx="7" fill="none" stroke-width={ficha ? 0.9 : 0.8} vector-effect="non-scaling-stroke" />
        {ficha && (
          <g stroke-width="0.9" stroke-linecap="round">
            <line x1="20" y1="44" x2="60" y2="44" vector-effect="non-scaling-stroke" />
            <line x1="26" y1="51" x2="54" y2="51" vector-effect="non-scaling-stroke" />
            <line x1="30" y1="57" x2="50" y2="57" vector-effect="non-scaling-stroke" />
            <circle cx="40" cy="28" r="7" fill="none" vector-effect="non-scaling-stroke" />
          </g>
        )}
      </>
    )}

    {tipo === 'pote' && (
      <>
        <path d="M11 24L77 24L70 62Q69.4 65 66.4 65L21.6 65Q18.6 65 18 62Z" fill={color} vector-effect="non-scaling-stroke" />
        {ficha && <line x1="13.4" y1="31" x2="74.6" y2="31" stroke-width="0.8" opacity="0.7" vector-effect="non-scaling-stroke" />}
        <path d="M14 11L74 11Q77 11 78.5 13.5L83 21.5Q84 24 81 24L7 24Q4 24 5 21.5L9.5 13.5Q11 11 14 11Z" fill="var(--dc-papel)" vector-effect="non-scaling-stroke" />
        <path d="M9.5 13.5L4 7.5Q3 5 5.5 5L12 5.5Q14 6 14 11" fill="var(--dc-papel)" vector-effect="non-scaling-stroke" />
        {ficha && (
          <g stroke-width="0.8" stroke-linecap="round" opacity="0.85">
            <line x1="24" y1="15.5" x2="64" y2="15.5" vector-effect="non-scaling-stroke" />
            <line x1="30" y1="19.5" x2="58" y2="19.5" vector-effect="non-scaling-stroke" />
          </g>
        )}
      </>
    )}

    {tipo === 'paquete' && (
      <>
        <polygon points={selloIzq} fill={color} vector-effect="non-scaling-stroke" />
        <polygon points={selloDer} fill={color} vector-effect="non-scaling-stroke" />
        <rect x="16" y="8" width="92" height="42" rx="7" fill={color} vector-effect="non-scaling-stroke" />
        {ficha && (
          <>
            <rect x="40" y="17" width="44" height="24" rx="3" fill="var(--dc-papel)" stroke-width="0.9" vector-effect="non-scaling-stroke" />
            <g stroke-width="0.8" stroke-linecap="round">
              <line x1="47" y1="25" x2="77" y2="25" vector-effect="non-scaling-stroke" />
              <line x1="51" y1="32" x2="73" y2="32" vector-effect="non-scaling-stroke" />
            </g>
            <g stroke-width="0.6" opacity="0.7">
              {[7, 10.5].map((x) => <line x1={x} y1="9" x2={x} y2="49" vector-effect="non-scaling-stroke" />)}
              {[113.5, 117].map((x) => <line x1={x} y1="9" x2={x} y2="49" vector-effect="non-scaling-stroke" />)}
            </g>
          </>
        )}
      </>
    )}
  </g>
</svg>
