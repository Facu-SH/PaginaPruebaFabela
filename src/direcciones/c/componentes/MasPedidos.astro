---
// "Lo que más sale": los más vendidos como rótulos de dorso de sobre, con su dibujo técnico.
import { categorias, empresa, masVendidos } from '../../../data';
import { waLink } from '../../../lib/whatsapp';
import { FORMATO, capitalizar, colorDe, colorVariante, envaseDe, listaNatural } from '../lib';
import Envase from './Envase.astro';
import SobreDpi from './SobreDpi.astro';

// Para qué se usa cada categoría (redacción, no datos).
const USO: Record<string, string> = {
  aderezos: 'el pancho, la hamburguesa, la bandeja del almuerzo',
  endulzantes: 'el café del bar, el té y el desayuno de la clínica',
  mermeladas: 'desayunos y meriendas, con la tostada',
  lacteos: 'la tostada de la mañana',
  'galletitas-y-tostadas': 'el desayuno y la merienda',
};

const fichas = masVendidos().map((p) => {
  const envase = envaseDe(p);
  const cat = categorias.find((c) => c.slug === p.categoria)!;
  // Con sabores, el nombre va en plural (el de la categoría): "Mermeladas".
  const nombre = p.variantes ? cat.nombre : p.nombre;
  return { p, nombre, envase, cat, formato: FORMATO[envase] };
});
const titulo = capitalizar(listaNatural(fichas.map((f) => f.nombre.toLowerCase())));
---
<div class="dc-mas">
  <div class="dc-mas__intro">
    <h2 class="dc-h2" id="dc-productos-h">{titulo} en porción individual: lo que más sale del depósito</h2>
    <p>
      Desde {empresa.desde}, solo porciones individuales. Estos tres son los que más se piden; abajo está todo lo que despachamos, renglón por renglón.
    </p>
  </div>

  <ol class="dc-mas__lista">
    {fichas.map(({ p, nombre, envase, cat, formato }) => (
      <li class:list={['dc-ficha', `dc-ficha--${envase}`]}>
        <div class="dc-ficha__dibujo">
          {p.slug === 'edulcorante' ? (
            <SobreDpi />
          ) : p.variantes && envase === 'pote' ? (
            <div class="dc-ficha__potes">
              {p.variantes.map((v) => (
                <figure>
                  <Envase tipo="pote" color={colorVariante(v, colorDe(p.slug))} />
                  <figcaption>{v}</figcaption>
                </figure>
              ))}
            </div>
          ) : (
            <div class="dc-ficha__pila">
              <Envase tipo={envase} color={colorDe(p.slug)} />
              <Envase tipo={envase} color={colorDe(p.slug)} />
              <Envase tipo={envase} color={colorDe(p.slug)} titulo={`Dibujo de un ${formato.nombre.toLowerCase()} de ${p.nombre.toLowerCase()}`} />
            </div>
          )}
        </div>
        <div class="dc-ficha__rotulo">
          <h3>
            {nombre}
            {p.marca && <span class="dc-ficha__marca">{p.marca}</span>}
          </h3>
          <dl>
            <div><dt>Formato</dt><dd>{formato.nombre}, {formato.detalle}</dd></div>
            {p.variantes && <div><dt>Sabores</dt><dd>{p.variantes.join(', ')}</dd></div>}
            <div><dt>Va con</dt><dd>{USO[cat.slug]}</dd></div>
            {p.nota && <div><dt>Nota</dt><dd>{p.nota}</dd></div>}
          </dl>
          <a class="dc-enlace" href={waLink('producto', { producto: `${nombre.toLowerCase()}${p.marca ? ` ${p.marca}` : ''}` })}>
            Consultar por {nombre.toLowerCase()}<span aria-hidden="true"> →</span>
          </a>
        </div>
      </li>
    ))}
  </ol>
</div>
