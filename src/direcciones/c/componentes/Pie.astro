---
// Pie sobre "papel carbónico": la hoja oscura que va entre las copias.
// Nombre, dirección y teléfono idénticos a src/data/empresa.ts.
import { empresa, horario } from '../../../data';
import { horaCorta, textoHorario } from '../../../lib/horario';
import { mailtoLink, telLink, waLink } from '../../../lib/whatsapp';
import Wordmark from './Wordmark.astro';

const { calle, localidad, partido, provincia } = empresa.direccion;
const atiende = empresa.whatsapp.atiende;
---
<footer class="dc-pie">
  <div class="dc-pie__cierre">
    <p class="dc-pie__frase">
      A las <span class="dc-pie__hora">{horaCorta(horario.abre)}</span> de la mañana ya estamos armando pedidos.
    </p>
    <a class="dc-boton dc-boton--amanecer" href={waLink('pedido')}>
      <span>Dejale tu pedido a {atiende}</span>
      <span class="dc-boton__flecha" aria-hidden="true">→</span>
    </a>
  </div>

  <div class="dc-pie__membrete">
    <Wordmark id="dc-wm-pie" class="dc-pie__wordmark" />
    <dl class="dc-pie__datos">
      <div><dt>Nombre</dt><dd>{empresa.nombreComercial} · {empresa.razonSocial}</dd></div>
      <div>
        <dt>Depósito</dt>
        <dd><address>{calle}, {localidad}, {partido}, {provincia}</address></dd>
      </div>
      <div><dt>Teléfono</dt><dd><a href={telLink()}>{empresa.telefono}</a></dd></div>
      <div><dt>Mail</dt><dd><a href={mailtoLink('general')}>{empresa.email}</a></dd></div>
      <div><dt>Horario</dt><dd>{textoHorario().replace(/ h$/, '\u00a0h')} · WhatsApp, teléfono y retiro</dd></div>
      <div>
        <dt>En el rubro</dt>
        <dd>
          Desde {empresa.desde}
          {empresa.clientesPublicables && <> · más de {empresa.clientesPublicables} clientes</>}
        </dd>
      </div>
    </dl>
  </div>
</footer>
