---
// Propuesta de wordmark "DPI" para la dirección C.
// Misma estructura que el logo actual (esfera + DPI + línea + "Productos Individuales"):
// la esfera pasa a ser un sol que asoma sobre la línea, que pasa a ser el horizonte de las 5 de la mañana.
// La parte del sol que queda bajo el horizonte se dibuja punteada, como una arista oculta en un plano técnico.
// Cuando DPI no está atendiendo (data-estado="cerrado" en .dc), el sol baja.
import { empresa } from '../../../data';

interface Props {
  /** Prefijo único para los ids de los recortes (hay más de un wordmark por página). */
  id: string;
  class?: string;
  /** Muestra la bajada "Productos Individuales". */
  bajada?: boolean;
  /** Decorativo (por ejemplo, dentro del dibujo del sobre): sin rol de imagen. */
  decorativo?: boolean;
  /** Posición y tamaño cuando va anidado dentro de otro SVG. */
  x?: number;
  y?: number;
  width?: number;
  height?: number;
}
const { id, class: clase, bajada = true, decorativo = false, ...posicion } = Astro.props;
const etiqueta = `${empresa.nombreComercial} · Productos Individuales`;
---
<svg
  class:list={['dc-wordmark', clase]}
  viewBox={bajada ? '0 0 134 74' : '0 0 134 62'}
  {...posicion}
  {...(decorativo ? { 'aria-hidden': 'true' } : { role: 'img', 'aria-label': etiqueta })}
>
  {!decorativo && <title>{etiqueta}</title>}
  <defs>
    <clipPath id={`${id}-cielo`}><rect x="0" y="0" width="134" height="56.7" /></clipPath>
    <clipPath id={`${id}-tierra`}><rect x="0" y="59.3" width="134" height="20" /></clipPath>
  </defs>
  <g clip-path={`url(#${id}-cielo)`}>
    <circle class="dc-sol" cx="24" cy="50" r="17" fill="var(--dc-amanecer)" />
  </g>
  <g clip-path={`url(#${id}-tierra)`}>
    <circle class="dc-sol" cx="24" cy="50" r="17" fill="none" stroke="currentColor" stroke-width="1.1" stroke-dasharray="2.4 2.2" opacity="0.7" />
  </g>
  <g fill="currentColor" fill-rule="evenodd">
    <path d="M50 14H66C75 14 80 19 80 28V40C80 49 75 54 66 54H50ZM61 23H64C67.5 23 69 25 69 29V39C69 43 67.5 45 64 45H61Z" />
    <path d="M85 14H101C109 14 113 18 113 26V30C113 38 109 42 101 42H96V54H85ZM96 22.5H99C101.5 22.5 102.5 23.5 102.5 26V30C102.5 32.5 101.5 33.5 99 33.5H96Z" />
    <path d="M118 14H129V54H118Z" />
  </g>
  <line x1="2" y1="58" x2="131" y2="58" stroke="currentColor" stroke-width="2.6" />
  {bajada && (
    <text x="129.5" y="69.5" text-anchor="end" class="dc-wordmark__bajada" fill="currentColor">PRODUCTOS INDIVIDUALES</text>
  )}
</svg>
