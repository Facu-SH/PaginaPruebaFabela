---
// El sobre de edulcorante de línea propia, redibujado con el wordmark propuesto.
// Toma del sobre real: papel blanco, borde dentado, marco de esquinas redondeadas,
// la franja verde en curva, el nombre del producto y el teléfono impreso.
import { empresa, productoPorSlug } from '../../../data';
import Wordmark from './Wordmark.astro';

interface Props {
  class?: string;
}
const { class: clase } = Astro.props;
const edulcorante = productoPorSlug('edulcorante');
const nombre = (edulcorante?.nombre ?? '').toUpperCase();

function bordeDentado(x: number, y: number, w: number, h: number, paso: number, amp: number) {
  const pts: string[] = [];
  const lado = (x0: number, y0: number, x1: number, y1: number, nx: number, ny: number) => {
    const n = Math.max(2, Math.round(Math.hypot(x1 - x0, y1 - y0) / paso)) * 2;
    for (let i = 0; i < n; i++) {
      const t = i / n;
      const off = i % 2 ? amp : 0;
      pts.push(`${(x0 + (x1 - x0) * t + nx * off).toFixed(2)},${(y0 + (y1 - y0) * t + ny * off).toFixed(2)}`);
    }
  };
  lado(x, y, x + w, y, 0, 1);
  lado(x + w, y, x + w, y + h, -1, 0);
  lado(x + w, y + h, x, y + h, 0, -1);
  lado(x, y + h, x, y, 1, 0);
  return `M${pts.join('L')}Z`;
}
---
<svg class:list={['dc-sobre-dpi', clase]} viewBox="0 0 220 186" role="img" aria-label={`Dibujo del sobre de ${edulcorante?.nombre.toLowerCase()} de línea propia ${empresa.nombreComercial}`}>
  <defs>
    <clipPath id="dc-sobre-dpi-papel"><rect x="14" y="14" width="192" height="158" rx="14" /></clipPath>
  </defs>
  <path d={bordeDentado(4, 4, 212, 178, 3.6, 2.4)} fill="#FFFFFF" stroke="var(--dc-tinta)" stroke-width="1.4" stroke-linejoin="round" />
  <g clip-path="url(#dc-sobre-dpi-papel)">
    <path d="M14 30C70 52 96 118 206 150L206 172L14 172Z" fill="#C6DDB8" />
  </g>
  <rect x="14" y="14" width="192" height="158" rx="14" fill="none" stroke="var(--dc-tinta)" stroke-width="1.2" />
  <Wordmark id="dc-sobre-wm" decorativo x={88} y={26} width={104} height={57} />
  <text x="132" y="112" text-anchor="middle" class="dc-sobre-dpi__producto">{nombre}</text>
  <text x="140" y="134" text-anchor="middle" class="dc-sobre-dpi__dato">Tel. {empresa.telefono}</text>
  <text x="140" y="148" text-anchor="middle" class="dc-sobre-dpi__dato">{empresa.email}</text>
</svg>
