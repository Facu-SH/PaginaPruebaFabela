---
// Un envase dibujado (decorativo salvo que se pase `titulo`). Usa los <symbol> de EnvasesSprite.
// Formas: almohadilla (aderezos), sobre-papel (azúcar, edulcorante DPI), pote (mermeladas, manteca,
// queso crema) y paquete (galletitas, vainillas, tostadas). Ninguna marca ajena va dibujada:
// el envase lleva solo el nombre genérico; el único logo es el del sobre DPI.
//
//   <Envase producto="mayonesa" />                     forma, color y nombre salen de src/data/
//   <Envase producto="mermeladas" sabor="durazno" />   un sabor puntual
//   <Envase formato="pote" clave="manteca" etiqueta="Manteca" />
import { categorias, empresa, productoPorSlug } from '../data';
import { colorEnvase } from '../lib/color';
import { telefonoCorto } from '../lib/textos';

export type Formato = 'almohadilla' | 'sobre-papel' | 'pote' | 'paquete';
type TipoPaquete = 'galletitas' | 'vainillas' | 'tostadas';

interface Props {
  /** Slug del producto: define forma, color y nombre impreso. */
  producto?: string;
  /** Sabor o variante (mermeladas): color y nombre del potecito. */
  sabor?: string;
  formato?: Formato;
  /** Clave de color (slug o sabor). */
  clave?: string;
  /** Texto impreso en el envase. */
  etiqueta?: string;
  /** Sobre DPI grande: con teléfono y mail impresos. */
  detalle?: boolean;
  /** Grosor del trazo (2 por defecto; 1.5 para envases chicos). */
  trazo?: number;
  /** Si el envase informa algo (no es decorativo), su descripción para lectores de pantalla. */
  titulo?: string;
  class?: string;
  style?: string;
}

const FORMATO_DE: Record<string, Formato> = { sobre: 'almohadilla', 'sobre-papel': 'sobre-papel', pote: 'pote', paquete: 'paquete' };

const props = Astro.props;
const p = props.producto ? productoPorSlug(props.producto) : undefined;
const cat = p ? categorias.find((c) => c.slug === p.categoria) : undefined;
const formato: Formato = props.formato ?? (cat ? FORMATO_DE[cat.envase] : 'almohadilla');
const sabor = props.sabor ?? (formato === 'pote' ? p?.variantes?.[0] : undefined);
const clave = props.clave ?? sabor ?? p?.slug ?? 'blanco';
const etiqueta = (props.etiqueta ?? sabor ?? p?.nombre ?? '').toUpperCase();
const { c, t } = colorEnvase(clave);
const esDPI = formato === 'sobre-papel' && (p?.slug ?? clave) === 'edulcorante';
const tipoPaquete: TipoPaquete = clave === 'vainillas' || clave === 'tostadas' ? clave : 'galletitas';
const { detalle = false, trazo, titulo, class: clase, style = '' } = props;

const caja = {
  almohadilla: '0 0 64 160',
  'sobre-papel': '0 0 130 100',
  pote: '0 0 100 100',
  paquete: { galletitas: '0 0 170 100', vainillas: '0 0 230 66', tostadas: '0 0 150 120' }[tipoPaquete],
}[formato];

// Tamaño de letra para que el nombre entre en el envase.
const tamAlm = Math.min(16, 100 / (etiqueta.length * 0.72));
const tamPote = Math.min(12.5, 80 / (etiqueta.length * 0.74));
const tel = `Tel. ${telefonoCorto()}`;
const a11y = titulo ? { role: 'img' as const, 'aria-label': titulo } : { 'aria-hidden': 'true' as const };
---
<svg
  class:list={['envase', `envase--${formato}`, formato === 'paquete' && `envase--${tipoPaquete}`, clase]}
  viewBox={caja}
  focusable="false"
  style={`--c:${c};${trazo ? `--trazo-env:${trazo};` : ''}${style}`}
  {...a11y}
>
  {formato === 'almohadilla' && (
    <>
      <use href="#env-alm" />
      <text x="80" y="-32" transform="rotate(90)" text-anchor="middle" dominant-baseline="central" font-size={tamAlm.toFixed(1)}
        style={`fill:${t};font-stretch:112%;font-weight:900;letter-spacing:.03em`}>{etiqueta}</text>
    </>
  )}

  {formato === 'sobre-papel' && (
    <>
      <use href="#env-sob" />
      {esDPI ? (
        <>
          <use href="#env-sob-curva" />
          <use href={detalle ? '#wm-completo' : '#wm-dpi'} x="50" y={detalle ? 15 : 17} width="64" height={detalle ? 25.3 : 19} style="--wm-punto:var(--verde);--wm-tinta:var(--tinta)" />
          <text x="70" y={detalle ? 56 : 58} text-anchor="middle" font-size={detalle ? 7.9 : 8.4}
            style="fill:var(--tinta);font-stretch:125%;font-weight:600;letter-spacing:.2em">{etiqueta}</text>
          <text x="70" y={detalle ? 70 : 72} text-anchor="middle" font-size={detalle ? 5.6 : 5.8} style="fill:var(--tinta);font-weight:500">{tel}</text>
          {detalle && <text x="70" y="78" text-anchor="middle" font-size="5" style="fill:var(--tinta);font-weight:500">{empresa.email}</text>}
        </>
      ) : (
        <>
          <use href="#env-sob-marco" />
          <text x="65" y="55" text-anchor="middle" font-size="13" style="fill:var(--tinta);font-stretch:125%;font-weight:800;letter-spacing:.12em">{etiqueta}</text>
        </>
      )}
    </>
  )}

  {formato === 'pote' && (
    <>
      <use href="#env-pote" />
      <text x="50" y="66.5" text-anchor="middle" dominant-baseline="central" font-size={tamPote.toFixed(1)}
        style={`fill:${t};font-stretch:100%;font-weight:900;letter-spacing:.04em`}>{etiqueta}</text>
    </>
  )}

  {formato === 'paquete' && (
    <>
      <use href={`#env-paq-${tipoPaquete}`} />
      {tipoPaquete === 'galletitas' && (
        <text x="85" y="22" text-anchor="middle" font-size="13" style="fill:var(--tinta);font-stretch:125%;font-weight:900;letter-spacing:.06em">{etiqueta}</text>
      )}
      {tipoPaquete === 'vainillas' && (
        <text x="44" y="33" text-anchor="middle" dominant-baseline="central" font-size="10.5" style="fill:var(--tinta);font-stretch:80%;font-weight:900;letter-spacing:.04em">{etiqueta}</text>
      )}
      {tipoPaquete === 'tostadas' && (
        <text x="75" y="23" text-anchor="middle" font-size="12.5" style="fill:var(--tinta);font-stretch:125%;font-weight:900;letter-spacing:.06em">{etiqueta}</text>
      )}
    </>
  )}
</svg>

