---
// Las formas de envase y el wordmark, dibujados una sola vez por página como <symbol> y reusados
// con <use> (ver Envase.astro y Wordmark.astro). Lo incluye el layout Sitio.astro.
// Los colores llegan por custom properties: --c (envase), --trazo-env (grosor de la línea),
// --wm-punto y --wm-tinta (wordmark).
import { contornoDentado, estriasLinea } from '../lib/dentado';
import { bajada, barra, caja, dpi, punto } from '../lib/wordmark';

const trazo = 'stroke:var(--tinta);stroke-width:var(--trazo-env,2);vector-effect:non-scaling-stroke;stroke-linejoin:round';
const Estria = (x0: number, x1: number, y0: number, y1: number, paso: number, vertical = true) => estriasLinea(x0, x1, y0, y1, paso, vertical);

// Almohadilla (sobre de aderezo) parada: 64 × 160, puntas crimpadas arriba y abajo.
const ALM = { w: 64, h: 160, sello: 18 };
const almContorno = contornoDentado(ALM.w, ALM.h, 5.4, 5, { arriba: true, abajo: true });
const almEstrias = [Estria(4, ALM.w - 4, 5, ALM.sello, 3.2), Estria(4, ALM.w - 4, ALM.h - ALM.sello, ALM.h - 5, 3.2)];

// Sobre de papel (azúcar, edulcorante): 130 × 100, dentado en los cuatro lados.
const SOB = { w: 130, h: 100, m: 10 };
const sobContorno = contornoDentado(SOB.w, SOB.h, 5, 3.4, { arriba: true, derecha: true, abajo: true, izquierda: true });
const sobEstrias = [
  Estria(6, SOB.w - 6, 3.4, SOB.m, 3),
  Estria(6, SOB.w - 6, SOB.h - SOB.m, SOB.h - 3.4, 3),
  Estria(3.4, SOB.m, SOB.m + 2, SOB.h - SOB.m - 2, 3, false),
  Estria(SOB.w - SOB.m, SOB.w - 3.4, SOB.m + 2, SOB.h - SOB.m - 2, 3, false),
];
// La curva verde del sobre de edulcorante DPI (dentro del margen sellado).
const curva = `M${SOB.m} ${SOB.m}H30C38 52 84 44 112 ${SOB.h - SOB.m}H${SOB.m}Z`;

// Paquetitos flow-pack: sellos dentados a los costados y una ventana con lo de adentro.
const PAQ = { galletitas: { w: 170, h: 100 }, vainillas: { w: 230, h: 66 }, tostadas: { w: 150, h: 120 } };
const s = 15; // ancho del sellado
const paquete = (w: number, h: number) => ({
  contorno: contornoDentado(w, h, 6, 5, { izquierda: true, derecha: true }),
  rayas: [Estria(5, s, 6, h - 6, 3, false), Estria(w - s, w - 5, 6, h - 6, 3, false)],
  sellos: `M${s} 0V${h}M${w - s} 0V${h}`,
});
const agujeros = (cx: number, cy: number) =>
  [[-6, -5], [6, -5], [0, 1], [-6, 7], [6, 7]].map(([dx, dy]) => `M${cx + dx + 1.7} ${cy + dy}a1.7 1.7 0 1 0 -3.4 0a1.7 1.7 0 1 0 3.4 0`).join('');
const g = paquete(PAQ.galletitas.w, PAQ.galletitas.h);
const va = paquete(PAQ.vainillas.w, PAQ.vainillas.h);
const to = paquete(PAQ.tostadas.w, PAQ.tostadas.h);
const altoDpi = 688 + barra.y + barra.alto;
---
<svg class="sprite-envases" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="env-alm" viewBox={`0 0 ${ALM.w} ${ALM.h}`}>
      <path d={almContorno} style={`fill:var(--c);${trazo}`} />
      {almEstrias.map((e) => <path d={e.d} style={e.estilo} />)}
      <path d={`M0 ${ALM.sello}H${ALM.w}M0 ${ALM.h - ALM.sello}H${ALM.w}`} style={`fill:none;${trazo}`} />
    </symbol>

    <symbol id="env-sob" viewBox={`0 0 ${SOB.w} ${SOB.h}`}>
      <path d={sobContorno} style={`fill:var(--c,#fff);${trazo}`} />
      {sobEstrias.map((e) => <path d={e.d} style={e.estilo} />)}
    </symbol>
    <symbol id="env-sob-curva" viewBox={`0 0 ${SOB.w} ${SOB.h}`}>
      <path d={curva} style="fill:var(--verde)" />
    </symbol>
    <symbol id="env-sob-marco" viewBox={`0 0 ${SOB.w} ${SOB.h}`}>
      <rect x="22" y="20" width="86" height="60" rx="9" style="fill:none;stroke:var(--tinta);stroke-width:1.6;vector-effect:non-scaling-stroke" />
    </symbol>

    <symbol id="env-pote" viewBox="0 0 100 100">
      <rect x="2" y="2" width="96" height="96" rx="16" style={`fill:var(--blanco);${trazo}`} />
      <rect x="13" y="13" width="74" height="74" rx="10" style="fill:var(--c)" />
      <path d="M18 2H58L98 42V82Q98 98 82 98H18Q2 98 2 82V18Q2 2 18 2Z" style={`fill:var(--env-aluminio);${trazo}`} />
      <rect x="2" y="54" width="96" height="24" style="fill:var(--c)" />
      <path d="M18 2H58L98 42V82Q98 98 82 98H18Q2 98 2 82V18Q2 2 18 2Z" style={`fill:none;${trazo}`} />
      <path d="M58 2L98 42H58Z" style={`fill:var(--env-aluminio-dorso);${trazo}`} />
    </symbol>

    <symbol id="env-paq-galletitas" viewBox={`0 0 ${PAQ.galletitas.w} ${PAQ.galletitas.h}`}>
      <path d={g.contorno} style={`fill:var(--galletita);${trazo}`} />
      {g.rayas.map((e) => <path d={e.d} style={e.estilo} />)}
      <path d={g.sellos} style={`fill:none;${trazo}`} />
      <rect x="28" y="33" width={PAQ.galletitas.w - 56} height="54" rx="9" style={`fill:var(--papel);${trazo}`} />
      {[52, 85, 118].map((cx) => <circle cx={cx} cy="60" r="15" style={`fill:var(--galletita);${trazo}`} />)}
      <path d={[52, 85, 118].map((cx) => agujeros(cx, 58)).join('')} style="fill:var(--tinta);opacity:.55" />
    </symbol>

    <symbol id="env-paq-vainillas" viewBox={`0 0 ${PAQ.vainillas.w} ${PAQ.vainillas.h}`}>
      <path d={va.contorno} style={`fill:var(--galletita);${trazo}`} />
      {va.rayas.map((e) => <path d={e.d} style={e.estilo} />)}
      <path d={va.sellos} style={`fill:none;${trazo}`} />
      <rect x="74" y="11" width={PAQ.vainillas.w - 74 - 25} height={PAQ.vainillas.h - 22} rx="8" style={`fill:var(--papel);${trazo}`} />
      {[0, 1, 2].map((i) => (
        <rect x={84 + i * 40} y={PAQ.vainillas.h / 2 - 7.5} width="34" height="15" rx="7.5" style={`fill:var(--galletita);${trazo}`} />
      ))}
    </symbol>

    <symbol id="env-paq-tostadas" viewBox={`0 0 ${PAQ.tostadas.w} ${PAQ.tostadas.h}`}>
      <path d={to.contorno} style={`fill:var(--galletita);${trazo}`} />
      {to.rayas.map((e) => <path d={e.d} style={e.estilo} />)}
      <path d={to.sellos} style={`fill:none;${trazo}`} />
      <rect x="26" y="34" width={PAQ.tostadas.w - 52} height="74" rx="9" style={`fill:var(--papel);${trazo}`} />
      {[{ x: 38, y: 44 }, { x: 62, y: 52 }].map(({ x, y }) => (
        <g transform={`translate(${x} ${y})`}>
          <path d="M5 50V22C-3 18 0 0 25 1C50 0 53 18 45 22V50Z" style={`fill:var(--galletita);${trazo}`} />
          <path d="M11 44V24C5 20 9 7 25 7C41 7 45 20 39 24V44Z" style="fill:var(--manteca)" />
        </g>
      ))}
    </symbol>

    <!-- Wordmark: el punto y las letras toman --wm-punto y --wm-tinta -->
    <symbol id="wm-dpi" viewBox={`${caja.x} ${caja.y} ${caja.ancho} ${altoDpi}`}>
      <rect x={barra.x} y={barra.y} width={barra.ancho} height={barra.alto} style="fill:var(--wm-tinta,var(--tinta))" />
      <circle cx={punto.cx} cy={punto.cy} r={punto.r} style="fill:var(--wm-punto,var(--verde))" />
      <path d={dpi} style="fill:var(--wm-tinta,var(--tinta))" />
    </symbol>
    <symbol id="wm-completo" viewBox={`${caja.x} ${caja.y} ${caja.ancho} ${caja.alto}`}>
      <use href="#wm-dpi" x={caja.x} y={caja.y} width={caja.ancho} height={altoDpi} />
      <path d={bajada} style="fill:var(--wm-tinta,var(--tinta))" />
    </symbol>
  </defs>
</svg>
