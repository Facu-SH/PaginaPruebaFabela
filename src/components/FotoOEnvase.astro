---
// Foto del producto si existe; si no, su envase dibujado. Así el sitio se ve terminado sin fotos.
//
// Para activar una foto: dejá un archivo en src/assets/productos/ con el slug del producto
// como nombre (mayonesa.jpg, edulcorante.png, mermeladas.webp…) y recompilá. No hay que tocar código.
// Si el producto tiene `foto` en src/data/productos.ts, se usa ese nombre de archivo en lugar del slug.
// Detalle y dirección de fotografía: docs/diseno.md.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { productoPorSlug } from '../data';
import Envase from './Envase.astro';

interface Props {
  /** Slug del producto. */
  producto: string;
  /** Sabor (para el dibujo de los potecitos). */
  sabor?: string;
  /** Texto alternativo de la foto. Por defecto: "<Producto> <marca> en porción individual". */
  alt?: string;
  /** sizes de la imagen responsiva (cuánto ocupa en pantalla). */
  sizes?: string;
  /** Ancho máximo de la foto en px (se generan 1x y 2x). */
  ancho?: number;
  /** Fuerza el dibujo aunque haya foto (por ejemplo, en filas repetidas). */
  soloDibujo?: boolean;
  class?: string;
  /** Props extra para el dibujo. */
  trazo?: number;
  detalle?: boolean;
}

const fotos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/productos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const porNombre = new Map(
  Object.entries(fotos).map(([ruta, m]) => [ruta.split('/').pop()!.replace(/\.\w+$/, '').toLowerCase(), m.default]),
);

const { producto, sabor, alt, sizes, ancho = 640, soloDibujo = false, class: clase, trazo, detalle } = Astro.props;
const p = productoPorSlug(producto);
const nombreArchivo = (p?.foto ?? producto).replace(/^.*\//, '').replace(/\.\w+$/, '').toLowerCase();
const foto = soloDibujo ? undefined : porNombre.get(nombreArchivo);
const textoAlt = alt ?? (p ? `${p.nombre}${p.marca ? ` ${p.marca}` : ''} en porción individual` : producto);
const anchos = [Math.round(ancho / 2), ancho, ancho * 2].filter((w) => !foto || w <= foto.width);
---
{foto ? (
  <Picture
    src={foto}
    alt={textoAlt}
    formats={['avif', 'webp']}
    widths={anchos.length ? anchos : [foto.width]}
    sizes={sizes ?? `(min-width: 1080px) ${ancho}px, 80vw`}
    class:list={['foto-producto', clase]}
    loading="lazy"
    decoding="async"
  />
) : (
  <Envase producto={producto} sabor={sabor} class={clase} trazo={trazo} detalle={detalle} />
)}

<style>
  .foto-producto { display: block; width: 100%; height: auto; object-fit: contain; }
</style>
