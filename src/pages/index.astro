---
import Sitio from '../layouts/Sitio.astro';
import TableroAtencion from '../components/TableroAtencion.astro';
import Envase from '../components/Envase.astro';
import FotoOEnvase from '../components/FotoOEnvase.astro';
---
<Sitio title="Prueba · DPI" description="Prueba">
  <TableroAtencion />
  <div style="display:flex;gap:10px;width:600px">
    <Envase producto="mayonesa" style="width:40px" />
    <Envase producto="edulcorante" style="width:120px" detalle />
    <Envase producto="mermeladas" sabor="durazno" style="width:80px" />
    <Envase producto="vainillas" style="width:120px" />
    <FotoOEnvase producto="tostadas" class="x" />
  </div>
</Sitio>
