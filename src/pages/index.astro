---
// Página temporal durante la fase 1: índice de las tres direcciones visuales.
// Se reemplaza por el inicio real en la fase 3.
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const direcciones = [
  { slug: 'a', nombre: 'A · Almacén de confianza' },
  { slug: 'b', nombre: 'B · Color de sobre' },
  { slug: 'c', nombre: 'C · Despacho a las 5 AM' },
];
---
<Base title="DPI — direcciones visuales (borrador)" noindex>
  <main style="font-family: system-ui, sans-serif; max-width: 40rem; margin: 3rem auto; padding: 0 1rem;">
    <h1 style="font-size: 1.5rem; margin-bottom: 1rem;">DPI — direcciones visuales</h1>
    <p style="margin-bottom: 1.5rem;">Borrador interno. Elegí una dirección para ver la home completa.</p>
    <ul style="display: grid; gap: 0.75rem; padding: 0; list-style: none;">
      {direcciones.map((d) => (
        <li><a href={url(`/direcciones/${d.slug}/`)}>{d.nombre}</a></li>
      ))}
    </ul>
  </main>
</Base>
