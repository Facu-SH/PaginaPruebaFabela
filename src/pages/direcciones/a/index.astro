---
// Fase 1 · Dirección A: "Almacén de confianza".
// Papel, kraft, el sobre impreso de DPI, sellos de goma y filetes. Ver docs/direcciones/a.md.
import '@fontsource-variable/alegreya/wght.css';
import '@fontsource-variable/alegreya/wght-italic.css';
import '@fontsource/alegreya-sc/latin-500.css';
import '@fontsource/alegreya-sc/latin-700.css';
import '@fontsource/alegreya-sans/latin-400.css';
import '@fontsource/alegreya-sans/latin-500.css';
import '@fontsource/alegreya-sans/latin-700.css';
import '../../../direcciones/a/estilos.css';

import Base from '../../../layouts/Base.astro';
import { empresa } from '../../../data';
import { lugar } from '../../../direcciones/a/lib/textos';
import Simbolos from '../../../direcciones/a/componentes/Simbolos.astro';
import Cabecera from '../../../direcciones/a/componentes/Cabecera.astro';
import Portada from '../../../direcciones/a/componentes/Portada.astro';
import Estante from '../../../direcciones/a/componentes/Estante.astro';
import Clinicas from '../../../direcciones/a/componentes/Clinicas.astro';
import Comercios from '../../../direcciones/a/componentes/Comercios.astro';
import Entregas from '../../../direcciones/a/componentes/Entregas.astro';
import Lista from '../../../direcciones/a/componentes/Lista.astro';
import Pie from '../../../direcciones/a/componentes/Pie.astro';
import BotonFlotante from '../../../direcciones/a/componentes/BotonFlotante.astro';

const titulo = `${empresa.nombreComercial} · Porciones individuales en ${lugar()} (dirección A)`;
const descripcion = `${empresa.razonSocial}: distribuidora de alimentos en porciones individuales de ${lugar()}, desde ${empresa.desde}.`;
---
<Base title={titulo} description={descripcion} noindex themeColor="#f3ecdf">
  <div class="dir-a">
    <Simbolos />
    <a class="a-saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido">
      <Portada />
      <Estante />
      <Clinicas />
      <Comercios />
      <Entregas />
      <Lista />
    </main>
    <Pie />
    <BotonFlotante />
  </div>
</Base>
