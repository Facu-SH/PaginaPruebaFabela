---
// <head> común: título, descripción, canonical, Open Graph, robots, theme-color y favicon.
// Las páginas usan Sitio.astro (que usa este layout); Base no tiene marca ni estilos.
import '../styles/reset.css';
import { empresa } from '../data';

interface Props {
  title: string;
  description?: string;
  /** true para páginas que no deben aparecer en buscadores (por ejemplo /sistema/). */
  noindex?: boolean;
  themeColor?: string;
  /** Imagen para compartir (Open Graph). Ruta del sitio ("/og/inicio.png") o URL absoluta. Se completa en la fase 4. */
  imagenOG?: string;
  /** Texto alternativo de la imagen OG. */
  imagenOGAlt?: string;
  tipoOG?: 'website' | 'article';
}
const { title, description, noindex = false, themeColor, imagenOG, imagenOGAlt, tipoOG = 'website' } = Astro.props;
const sitio = Astro.site ?? new URL(empresa.dominio);
const canonical = new URL(Astro.url.pathname, sitio).href;
const og = imagenOG ? new URL(imagenOG, sitio).href : undefined;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {themeColor && <meta name="theme-color" content={themeColor} />}
    <meta property="og:type" content={tipoOG} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={`${empresa.nombreComercial} · ${empresa.razonSocial}`} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={og} />}
    {og && imagenOGAlt && <meta property="og:image:alt" content={imagenOGAlt} />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
