---
// Plantillas de las piezas gráficas que se generan con Playwright (no son páginas del sitio):
// - og-<slug>: las imágenes para compartir (1200 × 630) de cada página de src/lib/paginas.ts;
// - logo: el logo cuadrado (600 × 600) para los datos estructurados;
// - qr-lista: la tarjeta del QR de la lista de precios, lista para imprimir (80 × 110 mm).
// Viven fuera de src/ a propósito: las compila aparte scripts/plantillas.mjs (`npm run og` y `npm run qr`)
// con srcDir = plantillas/, así nunca llegan a dist/ ni cambian cómo se arma el CSS del sitio.
import '../../src/styles/reset.css';
import '../../src/styles/tokens.css';
import '../../src/styles/base.css';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { categorias, empresa, entregas, horario, productoPorSlug, productosPorCategoria } from '../../src/data';
import { colorCategoria } from '../../src/lib/color';
import { fotoCategoria } from '../../src/lib/fotos';
import { horaCorta, textoHorario } from '../../src/lib/horario';
import { OG, paginas, type PiezaOG } from '../../src/lib/paginas';
import { diaDeReparto, telefonoCorto } from '../../src/lib/textos';
import Envase from '../../src/components/Envase.astro';
import EnvasesSprite from '../../src/components/EnvasesSprite.astro';
import Fuente from '../../src/components/Fuente.astro';
import Wordmark from '../../src/components/Wordmark.astro';

type Props = { tipo: 'og'; pieza: PiezaOG } | { tipo: 'logo' } | { tipo: 'qr' };

export const getStaticPaths = () => {
  return [
    ...paginas.map((p) => ({ params: { pieza: `og-${p.og.slug}` }, props: { tipo: 'og' as const, pieza: p.og } })),
    { params: { pieza: 'logo' }, props: { tipo: 'logo' as const } },
    { params: { pieza: 'qr-lista' }, props: { tipo: 'qr' as const } },
  ];
};

const props = Astro.props as Props;
const dominio = empresa.dominio.replace(/^https?:\/\//, '').replace(/\/$/, '');
const atiende = empresa.whatsapp.atiende;
const abre = horaCorta(horario.abre, true);

// ---------- Imagen OG ----------
const pieza = props.tipo === 'og' ? props.pieza : undefined;
const oscuro = pieza ? ['tinta', 'frutilla'].includes(pieza.fondo) : false;
const escena = pieza?.escena;
// Si hay foto de grupo de la categoría (src/assets/categorias/<slug>.jpg), va en lugar de los dibujos.
const foto = pieza && escena?.tipo === 'envases' && categorias.some((c) => c.slug === pieza.slug) ? fotoCategoria(pieza.slug) : undefined;
const filas = entregas.map((z) => ({ zona: z.zona.replace(/\s*\(.*\)\s*$/, ''), dia: z.dias === 'consultar' ? 'A consultar' : diaDeReparto(z).grande }));
const caja = categorias.map((c) => {
  const p = productosPorCategoria(c.slug)[0];
  return { slug: c.slug, nombre: c.nombre, fondo: colorCategoria[c.slug].fondo, texto: colorCategoria[c.slug].texto, producto: p.slug, sabor: p.variantes?.[0] };
});
/** Envase típico del producto ('sobre', 'sobre-papel', 'pote', 'paquete'), para el tamaño del dibujo. */
const formaDe = (producto: string) => categorias.find((c) => c.slug === productoPorSlug(producto)?.categoria)?.envase ?? 'sobre';
const partes = (texto: string) => {
  const i = texto.indexOf('?');
  return i === -1 ? { p: '', r: texto } : { p: texto.slice(0, i + 1), r: texto.slice(i + 1).trim() };
};

// ---------- QR ----------
const qrSvg = props.tipo === 'qr' ? readFileSync(join(process.cwd(), 'docs/qr/lista-qr.svg'), 'utf8') : '';
const qrDestino = new URL('/lista/', Astro.site ?? empresa.dominio).href.replace(/^https?:\/\//, '');
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Plantilla · {props.tipo}</title>
    <Fuente />
  </head>
  <body>
    <EnvasesSprite />

    {pieza && (
      <div
        class:list={['og', `og--${escena?.tipo}`, escena?.tipo === 'envases' && `og--${escena.forma}`, { 'og--oscuro': oscuro }]}
        style={`width:${OG.ancho}px;height:${OG.alto}px;--fondo:var(--${pieza.fondo});--texto:var(--${oscuro ? 'papel' : 'tinta'})`}
        data-lienzo
      >
        <div class="og__texto">
          <div class="og__marca">
            <Wordmark inline colorPunto={pieza.fondo === 'papel' || pieza.fondo === 'papel-hondo' || oscuro ? 'var(--verde)' : `var(--${pieza.fondo})`} />
          </div>
          <div class="og__titulos">
            <p class="og__rotulo">{pieza.rotulo}</p>
            <p class:list={['og__titular', { 'og__titular--largo': pieza.titular.length > 40 }]}>{pieza.titular}</p>
            <p class="og__dato">{pieza.dato}</p>
          </div>
          <p class="og__pie">
            <span>{dominio}</span>
            <span>Tel. {telefonoCorto()}</span>
            <span>WhatsApp desde las {abre}</span>
          </p>
        </div>

        <div class="og__escena">
          {escena?.tipo === 'sobre-dpi' && (
            <div class="og__sobre-dpi"><Envase producto="edulcorante" detalle trazo={2.5} /></div>
          )}

          {foto && (
            <div class="og__foto"><img src={foto.src} alt="" width={foto.width} height={foto.height} /></div>
          )}

          {!foto && escena?.tipo === 'envases' && (
            <div class="og__envases">
              {escena.envases.map((e) => (
                <div class:list={['og__envase', `og__envase--${formaDe(e.producto)}`, `og__envase--${e.producto}`]}>
                  <Envase producto={e.producto} sabor={e.sabor} detalle={e.producto === 'edulcorante'} trazo={2.5} />
                </div>
              ))}
            </div>
          )}

          {escena?.tipo === 'caja' && (
            <div class="og__caja">
              {caja.map((c) => (
                <div class:list={['og__comp', `og__comp--${c.slug}`]} style={`--c-fondo:var(--${c.fondo});--c-texto:var(--${c.texto})`}>
                  <span class="og__comp-nombre">{c.nombre}</span>
                  <div class="og__comp-envase"><Envase producto={c.producto} sabor={c.sabor} trazo={2} /></div>
                </div>
              ))}
            </div>
          )}

          {escena?.tipo === 'ruta' && (
            <div class="og__ruta">
              <p class="og__ruta-cabeza"><span>Zona</span><span>Día de reparto</span></p>
              {filas.map((f) => (
                <p class="og__ruta-fila"><span class="og__ruta-zona">{f.zona}</span><span class="og__ruta-dia">{f.dia}</span></p>
              ))}
            </div>
          )}

          {escena?.tipo === 'hora' && (
            <div class="og__hora">
              <p class="og__hora-rotulo">Arrancamos a las</p>
              <p class="og__hora-cifra">{abre}</p>
              <p class="og__hora-rotulo">{textoHorario()}</p>
            </div>
          )}

          {escena?.tipo === 'preguntas' && (
            <ol class="og__preguntas">
              {escena.preguntas.map((t, i) => {
                const { p, r } = partes(t);
                return (
                  <li>
                    <span class="og__preg-n">{String(i + 1).padStart(2, '0')}</span>
                    <span class="og__preg-p">{p}</span>
                    <span class="og__preg-r">{r}</span>
                  </li>
                );
              })}
            </ol>
          )}
        </div>
      </div>
    )}

    {props.tipo === 'logo' && (
      <div class="logo" style="width:600px;height:600px" data-lienzo>
        <Wordmark inline colorPunto="var(--verde)" />
      </div>
    )}

    {props.tipo === 'qr' && (
      <div class="qr" data-lienzo>
        <div class="qr__marca"><Wordmark inline colorPunto="var(--verde)" /></div>
        <div class="qr__codigo" set:html={qrSvg} />
        <p class="qr__leyenda">Escaneá y escribile a {atiende} por WhatsApp</p>
        <p class="qr__datos">{qrDestino} · Tel. {telefonoCorto()}</p>
      </div>
    )}
  </body>
</html>

<style is:global>
  html, body { margin: 0; background: var(--papel); }
  body { font-family: var(--fuente); color: var(--tinta); -webkit-font-smoothing: antialiased; }

  /* ======================= OG 1200 × 630 ======================= */
  .og {
    position: relative;
    display: grid;
    grid-template-columns: 650px 1fr;
    overflow: hidden;
    background: var(--fondo);
    color: var(--texto);
  }
  .og__texto {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    padding: 48px 0 44px 60px;
  }
  .og__marca {
    align-self: flex-start;
    padding: 14px 18px 12px;
    background: var(--papel);
    border: 3px solid var(--tinta);
    border-radius: 2px;
  }
  .og__marca .wordmark { width: 190px; }
  .og__titulos { display: grid; gap: 18px; }
  .og__rotulo {
    font-stretch: 125%;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .og__titular {
    font-stretch: 125%;
    font-weight: 900;
    font-size: 66px;
    line-height: 0.94;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .og__titular--largo { font-size: 56px; }
  .og__dato {
    max-width: 30em;
    font-stretch: 100%;
    font-weight: 800;
    font-size: 29px;
    line-height: 1.15;
  }
  .og__pie {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    font-stretch: 75%;
    font-weight: 700;
    font-size: 21px;
  }
  .og__pie span + span::before { content: '·'; margin-right: 22px; }

  .og__escena { position: relative; }

  /* El sobre DPI, grande y apenas girado */
  .og__sobre-dpi { position: absolute; left: 20px; right: -60px; top: 150px; transform: rotate(-6deg); }
  .og__sobre-dpi .envase { width: 100%; }

  /* Foto de grupo de la categoría: una etiqueta sobre el color, apenas girada */
  .og__foto { position: absolute; inset: 56px 52px 56px 10px; display: grid; place-items: center; }
  .og__foto img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    border: 3px solid var(--tinta);
    border-radius: 2px;
    transform: rotate(2deg);
  }

  /* Envases apoyados en el borde de abajo */
  .og__envases {
    position: absolute;
    inset: 40px 40px 0 10px;
    display: flex;
    flex-wrap: wrap-reverse;
    justify-content: center;
    align-items: flex-end;
    align-content: center;
    gap: 18px;
  }
  .og__envase { flex: none; }
  .og__envase .envase { width: 100%; }
  .og__envase--sobre { width: 112px; }
  .og__envase--sobre-papel { width: 300px; }
  .og__envase--pote { width: 190px; }
  .og__envase--paquete { width: 250px; }
  .og__envase:nth-child(odd) { transform: rotate(-4deg); }
  .og__envase:nth-child(even) { transform: rotate(3deg) translateY(-14px); }

  /* Aderezos: cuatro almohadillas paradas que salen por abajo */
  .og--almohadillas .og__envases { inset: 70px 30px -40px 0; flex-wrap: nowrap; gap: 12px; }
  .og--almohadillas .og__envase { width: 120px; }

  /* Endulzantes: el azúcar atrás, el edulcorante DPI adelante */
  .og--sobres .og__envases { display: block; }
  .og--sobres .og__envase { position: absolute; width: 400px; }
  .og--sobres .og__envase:first-child { left: 0; top: 30px; width: 330px; transform: rotate(-9deg); }
  .og--sobres .og__envase:last-child { right: -40px; bottom: 50px; transform: rotate(4deg); }

  /* Potecitos de a dos */
  .og--potes .og__envases { inset: 40px 50px 40px 20px; }
  .og--potes .og__envase { width: 205px; }
  .og--potes .og__envases:has(> :nth-child(2):last-child) .og__envase { width: 245px; }

  /* Paquetitos: galletitas y tostadas arriba, vainillas abajo */
  .og--paquetes .og__envases { inset: 40px 40px 40px 0; flex-wrap: wrap; gap: 26px 18px; }
  .og--paquetes .og__envase { width: 255px; }
  .og--paquetes .og__envase--vainillas { order: 2; width: 470px; }

  /* Mezcla (clínicas, comercios, lista): de distintos tamaños, en dos filas */
  .og--mezcla .og__envases { inset: 30px 40px 30px 0; }
  .og--mezcla .og__envase--sobre { width: 92px; }
  .og--mezcla .og__envase--sobre-papel { width: 250px; }
  .og--mezcla .og__envase--pote { width: 155px; }
  .og--mezcla .og__envase--paquete { width: 205px; }

  /* La caja: un compartimento por categoría */
  .og__caja {
    position: absolute;
    inset: 44px 48px 44px 10px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr 0.8fr;
    gap: 10px;
    padding: 10px;
    border: 3px solid var(--tinta);
    border-radius: 14px;
    background: var(--tinta);
  }
  .og__comp {
    position: relative;
    overflow: hidden;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--c-fondo);
    color: var(--c-texto);
  }
  .og__comp--galletitas-y-tostadas { grid-column: 1 / -1; }
  .og__comp-nombre {
    position: relative;
    z-index: 1;
    display: block;
    max-width: 9em;
    font-stretch: 125%;
    font-weight: 900;
    font-size: 21px;
    line-height: 0.98;
  }
  .og__comp-envase { position: absolute; right: 14px; bottom: -10px; width: 112px; transform: rotate(-6deg); }
  .og__comp--aderezos .og__comp-envase { width: 66px; right: 26px; bottom: -40px; transform: rotate(8deg); }
  .og__comp--endulzantes .og__comp-envase { width: 132px; right: 12px; bottom: 8px; }
  .og__comp--galletitas-y-tostadas .og__comp-envase { width: 170px; right: 26px; bottom: 6px; transform: rotate(-3deg); }

  /* La hoja de ruta */
  .og__ruta {
    position: absolute;
    inset: 70px 52px auto 10px;
    padding: 20px 26px 12px;
    background: var(--papel);
    border: 3px solid var(--tinta);
    border-radius: 2px;
    transform: rotate(1.5deg);
  }
  .og__ruta p { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; }
  .og__ruta-cabeza {
    padding-bottom: 10px;
    border-bottom: 3px solid var(--tinta);
    font-stretch: 125%;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .og__ruta-fila { padding: 15px 0 13px; border-bottom: 2px solid var(--tinta); }
  .og__ruta-fila:last-child { border-bottom: 0; }
  .og__ruta-zona { font-stretch: 75%; font-weight: 800; font-size: 27px; }
  .og__ruta-dia { font-stretch: 125%; font-weight: 900; font-size: 27px; text-align: right; }
  .og__ruta-fila:last-child .og__ruta-dia { font-weight: 700; color: var(--tinta-suave); }

  /* La hora de apertura */
  .og__hora { position: absolute; inset: 0 40px 0 0; display: flex; flex-direction: column; justify-content: center; align-items: flex-end; }
  .og__hora-cifra {
    color: var(--verde);
    font-stretch: 125%;
    font-weight: 900;
    font-size: 210px;
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .og__hora-rotulo { font-stretch: 125%; font-weight: 700; font-size: 18px; letter-spacing: 0.14em; text-transform: uppercase; }

  /* Preguntas frecuentes */
  .og__preguntas { position: absolute; top: 50%; left: 0; right: 52px; transform: translateY(-50%); display: grid; gap: 0; padding: 0; list-style: none; border-top: 3px solid var(--tinta); }
  .og__preguntas li {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 6px 10px;
    padding: 18px 0 16px;
    border-bottom: 2px solid var(--tinta);
  }
  .og__preg-n { grid-row: span 2; font-stretch: 75%; font-weight: 800; font-size: 26px; line-height: 1; }
  .og__preg-p { font-stretch: 112%; font-weight: 900; font-size: 28px; line-height: 1.05; }
  .og__preg-r { justify-self: start; padding: 2px 6px; background: var(--verde); font-weight: 700; font-size: 23px; line-height: 1.3; }

  /* ======================= Logo 600 × 600 ======================= */
  .logo { display: grid; place-items: center; background: var(--papel); }
  .logo .wordmark { width: 470px; }

  /* ======================= QR 80 × 110 mm ======================= */
  .qr {
    box-sizing: border-box;
    width: 80mm;
    height: 110mm;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 7mm 6mm 6mm;
    background: #fff;
    border: 0.8mm solid var(--tinta);
    border-radius: 4mm;
  }
  .qr__marca .wordmark { width: 40mm; }
  .qr__codigo { width: 56mm; margin-top: 3mm; }
  .qr__codigo svg { display: block; width: 100%; height: auto; }
  .qr__leyenda {
    margin-top: 1mm;
    font-stretch: 112%;
    font-weight: 900;
    font-size: 15.5pt;
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-align: center;
    text-wrap: balance;
  }
  .qr__datos { margin-top: auto; font-stretch: 75%; font-weight: 700; font-size: 9pt; text-align: center; }
  @page { size: 80mm 110mm; margin: 0; }
</style>
